% SP 800-22 Rev. 1a §§2.1–2.15 and 4.2. Combine observations only for
% the same test parameters, template, state, and direction across streams.
sts_suite: THEORY
BEGIN
  IMPORTING sts_spectral,sts_walk,sts_complexity
  deciles:TYPE=ARRAY[below(10)->uint32]
  tally:TYPE=[# eligible,passed:uint32,bins:deciles #]
  start:tally=(# eligible:=0,passed:=0,bins:=LAMBDA(i:below(10)):0 #)
  decile(p:fp,i:below(10)):RECURSIVE below(10)=
    IF i=9 OR fp_lt(p,ratio(i+1,10)) THEN i ELSE decile(p,i+1) ENDIF MEASURE 9-i
  accumulate(a:tally,v:observation,alpha:fp):tally=
    IF NOT v`applicable OR a`eligible=4294967295 THEN a ELSE LET j=decile(v`pvalue,0) IN
      a WITH [eligible:=u32plus(a`eligible,1),passed:=IF accepts(v,alpha) THEN u32plus(a`passed,1) ELSE a`passed ENDIF,
              `bins(j):=u32plus(a`bins(j),1)] ENDIF
  uniform_sum(a:tally,i:upto(10),expected,sum:fp):RECURSIVE fp=
    IF i=10 THEN sum ELSE uniform_sum(a,i+1,expected,fp_add(sum,deviation(fl(a`bins(i)),expected))) ENDIF MEASURE 10-i
  uniformity(a:tally):observation=IF a`eligible<10 THEN omitted ELSE
    observed(chi_tail(9,uniform_sum(a,0,ratio(a`eligible,10),fl(0)))) ENDIF
  within_interval(a:tally,alpha:fp):bool=
    IF a`eligible=0 THEN FALSE ELSE LET p=fp_sub(fl(1),alpha),
      delta=fp_mul(fl(3),fp_sqrt(fp_div(fp_mul(alpha,p),fl(a`eligible)))),
      observed_rate=ratio(a`passed,a`eligible) IN
      NOT fp_lt(observed_rate,fp_sub(p,delta)) AND NOT fp_lt(fp_add(p,delta),observed_rate) ENDIF
  template_count(m:subrange(1,31),limit:uint32,i:upto(limit),total:uint32):RECURSIVE uint32=
    IF i=limit THEN total ELSE template_count(m,limit,i+1,IF unbordered(i,m,1) THEN u32plus(total,1) ELSE total ENDIF)
    ENDIF MEASURE limit-i
  % Recounting the printed 50-bit string in §2.8.4 gives block
  % counts 5,1,3,4,1. Use those counts and the chi-square survival tail.
  overlap_example:bitstream=(# n:=50,bits:=LAMBDA(i:below(50)):u64and(u64rshift(825926988063081,49-i),1)=1 #)
  overlap_example_statistic: THEOREM
    LET r=overlapping_parameters(overlap_example,2,10,5) IN r`applicable AND
      fp_lt(fp_abs(fp_sub(r`pvalue,chi_tail(5,ratio(5051441,1000000)))),ratio(1,100000))
  default_template_count: THEOREM template_count(9,512,0,0)=148
  probability_result(v:observation):bool=NOT v`applicable OR
    (NOT fp_lt(v`pvalue,fl(0)) AND NOT fp_lt(fl(1),v`pvalue))
  test_probabilities: THEOREM FORALL(x:bitstream,m:subrange(2,29),pat:uint32,
                                     L:block_width,st:excursion_state,mode:bool):
    probability_result(frequency(x)) AND probability_result(block_frequency(x,m)) AND
    probability_result(runs(x)) AND probability_result(longest_run(x)) AND probability_result(rank_test(x)) AND
    probability_result(spectral(x)) AND probability_result(nonoverlapping(x,pat,m)) AND
    probability_result(overlapping(x)) AND probability_result(universal(x,L)) AND
    probability_result(linear_complexity(x,500)) AND probability_result(serial(x,m,mode)) AND
    probability_result(approximate_entropy(x,m)) AND probability_result(cumulative_sums(x,mode)) AND
    probability_result(excursion(x,st,FALSE)) AND probability_result(excursion(x,st,TRUE))
  omitted_excluded: THEOREM FORALL(a:tally,alpha:fp):accumulate(a,omitted,alpha)=a
  rejected_inapplicable: THEOREM FORALL(alpha:fp):NOT accepts(omitted,alpha)
END sts_suite
