      (0x4a25619d :: uint32),(0x1e8c94e0 :: uint32),(0xdb0933d7 :: uint32),(0xabf5ae8c :: uint32),(0xa6e1e4c7 :: uint32),(0xb3970f85 :: uint32),
      (0x5d060c7d :: uint32),(0x8aea7157 :: uint32),(0x58dbef0a :: uint32),(0xecfb8504 :: uint32),(0xdf1cba64 :: uint32),(0xa85521ab :: uint32),
      (0x04507a33 :: uint32),(0xad33170d :: uint32),(0x8aaac42d :: uint32),(0x15728e5a :: uint32),(0x98fa0510 :: uint32),(0x15d22618 :: uint32),
      (0xea956ae5 :: uint32),(0x3995497c :: uint32),(0x95581718 :: uint32),(0xde2bcbf6 :: uint32),(0x6f4c52c9 :: uint32),(0xb5c55df0 :: uint32),
      (0xec07a28f :: uint32),(0x9b2783a2 :: uint32),(0x180e8603 :: uint32),(0xe39e772c :: uint32),(0x2e36ce3b :: uint32),(0x32905e46 :: uint32),
      (0xca18217c :: uint32),(0xf1746c08 :: uint32),(0x4abc9804 :: uint32),(0x670c354e :: uint32),(0x7096966d :: uint32),(0x9ed52907 :: uint32),
      (0x208552bb :: uint32),(0x1c62f356 :: uint32),(0xdca3ad96 :: uint32),(0x83655d23 :: uint32),(0xfd24cf5f :: uint32),(0x69163fa8 :: uint32),
      (0x1c55d39a :: uint32),(0x98da4836 :: uint32),(0xa163bf05 :: uint32),(0xc2007cb8 :: uint32),(0xece45b3d :: uint32),(0x49286651 :: uint32),
      (0x7c4b1fe6 :: uint32),(0xae9f2411 :: uint32),(0x5a899fa5 :: uint32),(0xee386bfb :: uint32),(0xf406b7ed :: uint32),(0x0bff5cb6 :: uint32),
      (0xa637ed6b :: uint32),(0xf44c42e9 :: uint32),(0x625e7ec6 :: uint32),(0xe485b576 :: uint32),(0x6d51c245 :: uint32),(0x4fe1356d :: uint32),
      (0xf25f1437 :: uint32),(0x302b0a6d :: uint32),(0xcd3a431b :: uint32),(0xef9519b3 :: uint32),(0x8e3404dd :: uint32),(0x514a0879 :: uint32),
      (0x3b139b22 :: uint32),(0x020bbea6 :: uint32),(0x8a67cc74 :: uint32),(0x29024e08 :: uint32),(0x80dc1cd1 :: uint32),(0xc4c6628b :: uint32),
      (0x2168c234 :: uint32),(0xc90fdaa2 :: uint32),(0xffffffff :: uint32),(0xffffffff :: uint32):] #)
  modulus(id:group_id): limbs =
    CASES id OF
      ffdhe2048:p_ffdhe2048,
      ffdhe3072:p_ffdhe3072,
      ffdhe4096:p_ffdhe4096,
      ffdhe6144:p_ffdhe6144,
      ffdhe8192:p_ffdhe8192,
      modp2048:p_modp2048,
      modp3072:p_modp3072,
      modp4096:p_modp4096,
      modp6144:p_modp6144,
      modp8192:p_modp8192 ENDCASES
  subgroup(p:limbs): words_of(p`len) =
    (# len:=p`len,word:=LAMBDA(i:below(p`len)):
         LET carry:uint32=IF i+1<p`len THEN u32lshift(p`word(i+1),31) ELSE 0 ENDIF
         IN u32or(u32rshift(p`word(i),1),carry) #)
  named(id:group_id): domain =
    LET p=modulus(id), g=zero_words(p`len) WITH [`word(0):=2] IN
      (# p:=p,q:=subgroup(p),g:=g #)
END ff_groups
