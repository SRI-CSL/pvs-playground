% RFC 8032 sections 7.4 and 7.5. Pure Ed448 blank message and prehash abc with context.
ed448_examples: THEORY
BEGIN
  IMPORTING ed448
  pure_seed: octets_of(57) =
    (# length := 57, seq := [: 0x6c, 0x82, 0xa5, 0x62, 0xcb, 0x80, 0x8d, 0x10,
      0xd6, 0x32, 0xbe, 0x89, 0xc8, 0x51, 0x3e, 0xbf,
      0x6c, 0x92, 0x9f, 0x34, 0xdd, 0xfa, 0x8c, 0x9f,
      0x63, 0xc9, 0x96, 0x0e, 0xf6, 0xe3, 0x48, 0xa3,
      0x52, 0x8c, 0x8a, 0x3f, 0xcc, 0x2f, 0x04, 0x4e,
      0x39, 0xa3, 0xfc, 0x5b, 0x94, 0x49, 0x2f, 0x8f,
      0x03, 0x2e, 0x75, 0x49, 0xa2, 0x00, 0x98, 0xf9,
      0x5b :] #)
  pure_vk: octets_of(57) =
    (# length := 57, seq := [: 0x5f, 0xd7, 0x44, 0x9b, 0x59, 0xb4, 0x61, 0xfd,
      0x2c, 0xe7, 0x87, 0xec, 0x61, 0x6a, 0xd4, 0x6a,
      0x1d, 0xa1, 0x34, 0x24, 0x85, 0xa7, 0x0e, 0x1f,
      0x8a, 0x0e, 0xa7, 0x5d, 0x80, 0xe9, 0x67, 0x78,
      0xed, 0xf1, 0x24, 0x76, 0x9b, 0x46, 0xc7, 0x06,
      0x1b, 0xd6, 0x78, 0x3d, 0xf1, 0xe5, 0x0f, 0x6c,
      0xd1, 0xfa, 0x1a, 0xbe, 0xaf, 0xe8, 0x25, 0x61,
      0x80 :] #)
  pure_signature_a: octets_of(57) =
    (# length := 57, seq := [: 0x53, 0x3a, 0x37, 0xf6, 0xbb, 0xe4, 0x57, 0x25,
      0x1f, 0x02, 0x3c, 0x0d, 0x88, 0xf9, 0x76, 0xae,
      0x2d, 0xfb, 0x50, 0x4a, 0x84, 0x3e, 0x34, 0xd2,
      0x07, 0x4f, 0xd8, 0x23, 0xd4, 0x1a, 0x59, 0x1f,
      0x2b, 0x23, 0x3f, 0x03, 0x4f, 0x62, 0x82, 0x81,
      0xf2, 0xfd, 0x7a, 0x22, 0xdd, 0xd4, 0x7d, 0x78,
      0x28, 0xc5, 0x9b, 0xd0, 0xa2, 0x1b, 0xfd, 0x39,
      0x80 :] #)
  pure_signature_b: octets_of(57) =
    (# length := 57, seq := [: 0xff, 0x0d, 0x20, 0x28, 0xd4, 0xb1, 0x8a, 0x9d,
      0xf6, 0x3e, 0x00, 0x6c, 0x5d, 0x1c, 0x2d, 0x34,
      0x5b, 0x92, 0x5d, 0x8d, 0xc0, 0x0b, 0x41, 0x04,
      0x85, 0x2d, 0xb9, 0x9a, 0xc5, 0xc7, 0xcd, 0xda,
      0x85, 0x30, 0xa1, 0x13, 0xa0, 0xf4, 0xdb, 0xb6,
      0x11, 0x49, 0xf0, 0x5a, 0x73, 0x63, 0x26, 0x8c,
      0x71, 0xd9, 0x58, 0x08, 0xff, 0x2e, 0x65, 0x26,
      0x00 :] #)
  pure_signature: octets_of(114) = join_octets(pure_signature_a,pure_signature_b)
  pure_msg: octets_of(0) = fill_octets(0,0)
  pure_ctx: octets_of(0) = fill_octets(0,0)
  derive_verification_key: _TEST_ public_key(pure_seed) = pure_vk
  pure_sign: _TEST_ sign(pure_seed,pure_msg,pure_ctx) = pure_signature
  pure_verify: _TEST_ verify(pure_vk,pure_msg,pure_signature,pure_ctx)
  ph_seed: octets_of(57) =
    (# length := 57, seq := [: 0x83, 0x3f, 0xe6, 0x24, 0x09, 0x23, 0x7b, 0x9d,
      0x62, 0xec, 0x77, 0x58, 0x75, 0x20, 0x91, 0x1e,
      0x9a, 0x75, 0x9c, 0xec, 0x1d, 0x19, 0x75, 0x5b,
      0x7d, 0xa9, 0x01, 0xb9, 0x6d, 0xca, 0x3d, 0x42,
      0xef, 0x78, 0x22, 0xe0, 0xd5, 0x10, 0x41, 0x27,
      0xdc, 0x05, 0xd6, 0xdb, 0xef, 0xde, 0x69, 0xe3,
      0xab, 0x2c, 0xec, 0x7c, 0x86, 0x7c, 0x6e, 0x2c,
      0x49 :] #)
  ph_vk: octets_of(57) =
    (# length := 57, seq := [: 0x25, 0x9b, 0x71, 0xc1, 0x9f, 0x83, 0xef, 0x77,
      0xa7, 0xab, 0xd2, 0x65, 0x24, 0xcb, 0xdb, 0x31,
      0x61, 0xb5, 0x90, 0xa4, 0x8f, 0x7d, 0x17, 0xde,
      0x3e, 0xe0, 0xba, 0x9c, 0x52, 0xbe, 0xb7, 0x43,
      0xc0, 0x94, 0x28, 0xa1, 0x31, 0xd6, 0xb1, 0xb5,
      0x73, 0x03, 0xd9, 0x0d, 0x81, 0x32, 0xc2, 0x76,
      0xd5, 0xed, 0x3d, 0x5d, 0x01, 0xc0, 0xf5, 0x38,
      0x80 :] #)
  ph_signature_a: octets_of(57) =
    (# length := 57, seq := [: 0xc3, 0x22, 0x99, 0xd4, 0x6e, 0xc8, 0xff, 0x02,
      0xb5, 0x45, 0x40, 0x98, 0x28, 0x14, 0xdc, 0xe9,
      0xa0, 0x58, 0x12, 0xf8, 0x19, 0x62, 0xb6, 0x49,
      0xd5, 0x28, 0x09, 0x59, 0x16, 0xa2, 0xaa, 0x48,
      0x10, 0x65, 0xb1, 0x58, 0x04, 0x23, 0xef, 0x92,
      0x7e, 0xcf, 0x0a, 0xf5, 0x88, 0x8f, 0x90, 0xda,
      0x0f, 0x6a, 0x9a, 0x85, 0xad, 0x5d, 0xc3, 0xf2,
      0x80 :] #)
  ph_signature_b: octets_of(57) =
    (# length := 57, seq := [: 0xd9, 0x12, 0x24, 0xba, 0x99, 0x11, 0xa3, 0x65,
      0x3d, 0x00, 0xe4, 0x84, 0xe2, 0xce, 0x23, 0x25,
      0x21, 0x48, 0x1c, 0x86, 0x58, 0xdf, 0x30, 0x4b,
      0xb7, 0x74, 0x5a, 0x73, 0x51, 0x4c, 0xdb, 0x9b,
      0xf3, 0xe1, 0x57, 0x84, 0xab, 0x71, 0x28, 0x4f,
      0x8d, 0x07, 0x04, 0xa6, 0x08, 0xc5, 0x4a, 0x6b,
      0x62, 0xd9, 0x7b, 0xeb, 0x51, 0x1d, 0x13, 0x21,
      0x00 :] #)
  ph_signature: octets_of(114) = join_octets(ph_signature_a,ph_signature_b)
  ph_msg: octets_of(3) =
    (# length := 3, seq := [: 0x61, 0x62, 0x63 :] #)
  ph_ctx: octets_of(3) =
    (# length := 3, seq := [: 0x66, 0x6f, 0x6f :] #)
  ph_sign: _TEST_ sign_ph(ph_seed,ph_msg,ph_ctx) = ph_signature
  ph_verify: _TEST_ verify_ph(ph_vk,ph_msg,ph_signature,ph_ctx)
  reject_noncanonical_high_octet: _TEST_
    NOT verify(pure_vk,pure_msg,pure_signature WITH [`seq(113) := 1],pure_ctx)
  reject_noncanonical_point: _TEST_ NOT decompress(pure_vk WITH [`seq(56) := 1])`valid
END ed448_examples
