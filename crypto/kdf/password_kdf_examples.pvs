% PBKDF2-HMAC-SHA-256, RFC 7914 section 11. The short salt is an
% algorithm example. storage_key requires the longer SP 800-132 salt.
password_kdf_examples: THEORY
BEGIN
  IMPORTING password_kdf
  pwd: octets_of(6) =
    (# length := 6, seq := [: 0x70, 0x61, 0x73, 0x73, 0x77, 0x64 :] #)
  salt: octets_of(4) =
    (# length := 4, seq := [: 0x73, 0x61, 0x6c, 0x74 :] #)
  rfc_output: octets_of(64) =
    (# length := 64, seq := [: 0x55, 0xac, 0x04, 0x6e, 0x56, 0xe3, 0x08, 0x9f,
      0xec, 0x16, 0x91, 0xc2, 0x25, 0x44, 0xb6, 0x05,
      0xf9, 0x41, 0x85, 0x21, 0x6d, 0xde, 0x04, 0x65,
      0xe6, 0x8b, 0x9d, 0x57, 0xc2, 0x0d, 0xac, 0xbc,
      0x49, 0xca, 0x9c, 0xcc, 0xf1, 0x79, 0xb6, 0x45,
      0x99, 0x16, 0x64, 0xb3, 0x9d, 0x77, 0xef, 0x31,
      0x7c, 0x71, 0xb8, 0x45, 0xb1, 0xe3, 0x0b, 0xd5,
      0x09, 0x11, 0x20, 0x41, 0xd3, 0xa1, 0x97, 0x83 :] #)
  two_blocks: _TEST_ pbkdf2(h_sha256, pwd, salt, 1, 64) = rfc_output
% Supplemental iterated, partial-final-block test calculated with Python hashlib.
  long_salt: octets_of(16) =
    (# length := 16, seq := [: 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
      0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f :] #)
  derived: octets_of(35) =
    (# length := 35, seq := [: 0x78, 0x53, 0xe4, 0xb9, 0xa8, 0x79, 0xd4, 0xd5,
      0x0c, 0xfb, 0xd6, 0xb4, 0xf2, 0xad, 0x8a, 0x6d,
      0xcf, 0x60, 0x04, 0xff, 0x45, 0x46, 0xd7, 0x1d,
      0x98, 0x54, 0x8d, 0x3e, 0xf5, 0x2a, 0x86, 0x15,
      0xf4, 0x50, 0x8d :] #)
  iterated_partial: _TEST_ storage_key(h_sha256, pwd, long_salt, 1000, 35) = derived
END password_kdf_examples
