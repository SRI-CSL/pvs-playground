% FIPS 186-5 §§7.3–7.7. Both claims use an accepted verification key.
ed25519_claims: THEORY
BEGIN
  IMPORTING ed25519
  accepted_seed(seed:scalar_bytes): bool =
    LET p=decode_point(public_key(seed)) IN p`valid AND valid_decoded_key(p`p)
  pure_correct: THEOREM FORALL (seed:(accepted_seed),m:message):
    verify(public_key(seed),m,sign(seed,m))
  prehash_correct: THEOREM FORALL (seed:(accepted_seed),m:bytestring,c:context_bytes):
    verify_ph(public_key(seed),m,sign_ph(seed,m,c),c)
END ed25519_claims
