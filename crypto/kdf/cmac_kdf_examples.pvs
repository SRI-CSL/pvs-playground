% NIST KBKDFVS COUNT=0, counter before fixed input (8-bit), feedback and
% double-pipeline without counter. The latter two request multiple output blocks.
% https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/key-derivation
cmac_kdf_examples: THEORY
BEGIN
  IMPORTING cmac_kdf
  nil_bytes: octets_of(0) = fill_octets(0,0)
  ki0: octets_of(16) =
    (# length := 16, seq := [: 0xdf, 0xf1, 0xe5, 0x0a, 0xc0, 0xb6, 0x9d, 0xc4,
      0x0f, 0x10, 0x51, 0xd4, 0x6c, 0x2b, 0x06, 0x9c :] #)
  fixedinputdata0: octets_of(60) =
    (# length := 60, seq := [: 0xc1, 0x6e, 0x6e, 0x02, 0xc5, 0xa3, 0xdc, 0xc8,
      0xd7, 0x8b, 0x9a, 0xc1, 0x30, 0x68, 0x77, 0x76,
      0x13, 0x10, 0x45, 0x5b, 0x4e, 0x41, 0x46, 0x99,
      0x51, 0xd9, 0xe6, 0xc2, 0x24, 0x5a, 0x06, 0x4b,
      0x33, 0xfd, 0x8c, 0x3b, 0x01, 0x20, 0x3a, 0x78,
      0x24, 0x48, 0x5b, 0xf0, 0xa6, 0x40, 0x60, 0xc4,
      0x64, 0x8b, 0x70, 0x7d, 0x26, 0x07, 0x93, 0x56,
      0x99, 0x31, 0x6e, 0xa5 :] #)
  ko0: octets_of(16) =
    (# length := 16, seq := [: 0x8b, 0xe8, 0xf0, 0x86, 0x9b, 0x3c, 0x0b, 0xa9,
      0x7b, 0x71, 0x86, 0x3d, 0x1b, 0x9f, 0x78, 0x13 :] #)
  vector0: _TEST_ kbkdf_cmac(mk128(ki0`seq),0,1,fixedinputdata0,nil_bytes,16)`data = ko0
  ki1: octets_of(16) =
    (# length := 16, seq := [: 0x5c, 0x99, 0x6c, 0x92, 0x2f, 0x65, 0xde, 0x97,
      0xd4, 0x40, 0x83, 0x73, 0x22, 0x98, 0x14, 0xc6 :] #)
  iv1: octets_of(16) =
    (# length := 16, seq := [: 0x28, 0xdc, 0x94, 0x5c, 0xb8, 0x33, 0x7a, 0xb5,
      0x33, 0x6c, 0x3e, 0x9b, 0x5b, 0xad, 0x21, 0xc7 :] #)
  fixedinputdata1: octets_of(51) =
    (# length := 51, seq := [: 0x62, 0xaf, 0xe5, 0xfe, 0xd9, 0x1e, 0x79, 0x72,
      0x21, 0xa8, 0x54, 0x33, 0x6b, 0x0a, 0xad, 0xd8,
      0xa0, 0x5a, 0xd0, 0xe3, 0xc8, 0x34, 0x57, 0x29,
      0x89, 0x7b, 0x2e, 0xfc, 0xec, 0x5a, 0x11, 0x78,
      0xa2, 0xfa, 0x4c, 0x06, 0x30, 0x07, 0xb6, 0x7a,
      0x70, 0x15, 0xe0, 0xd6, 0xb7, 0x27, 0x1e, 0xa8,
      0xd8, 0x6b, 0x44 :] #)
  ko1: octets_of(64) =
    (# length := 64, seq := [: 0x88, 0xa9, 0xaa, 0xe1, 0x93, 0xab, 0xdd, 0x3f,
      0xe8, 0x14, 0x3b, 0xab, 0x66, 0x01, 0x4a, 0xe4,
      0x1d, 0xc2, 0xd1, 0x2e, 0xa9, 0xd0, 0x8f, 0x58,
      0x71, 0x58, 0x8f, 0xc5, 0xd8, 0x27, 0x92, 0x4e,
      0xb9, 0x94, 0x29, 0x89, 0xd7, 0xa3, 0x6d, 0x4b,
      0x3b, 0x10, 0x79, 0x97, 0x56, 0x64, 0x72, 0xca,
      0xd5, 0x94, 0x2b, 0xd1, 0x3c, 0xb5, 0xcf, 0xf3,
      0x2b, 0x9d, 0xae, 0x30, 0xf1, 0xbb, 0x63, 0x00 :] #)
  vector1: _TEST_ kbkdf_cmac(mk128(ki1`seq),1,0,fixedinputdata1,iv1,64)`data = ko1
  ki2: octets_of(16) =
    (# length := 16, seq := [: 0xad, 0xa2, 0x45, 0x2f, 0x1f, 0x14, 0x1a, 0x82,
      0xc7, 0xa1, 0xb7, 0xd3, 0xe0, 0x9f, 0xfe, 0xd1 :] #)
  fixedinputdata2: octets_of(51) =
    (# length := 51, seq := [: 0x33, 0x56, 0x60, 0xeb, 0x26, 0x5d, 0x20, 0x44,
      0xef, 0xa0, 0x6e, 0xac, 0xd8, 0x48, 0xd3, 0xf9,
      0xf5, 0x7d, 0x21, 0x90, 0x11, 0x34, 0x33, 0x18,
      0xf3, 0xa9, 0x64, 0xdf, 0x4a, 0x6f, 0xb1, 0xbf,
      0x6c, 0xbd, 0xee, 0x71, 0x1c, 0x7f, 0xcb, 0xe7,
      0x3b, 0x8f, 0x25, 0x7f, 0x99, 0x2e, 0x47, 0xe8,
      0xb0, 0x65, 0xaf :] #)
  ko2: octets_of(64) =
    (# length := 64, seq := [: 0xa7, 0x3b, 0xd2, 0x91, 0x76, 0xe3, 0x8e, 0x76,
      0x12, 0x22, 0xae, 0x07, 0xd6, 0x39, 0x18, 0x1f,
      0x4b, 0x2c, 0x55, 0x5a, 0x3b, 0x26, 0x18, 0x15,
      0xcd, 0xe5, 0xd8, 0x8a, 0x67, 0xc8, 0xb9, 0x5c,
      0x58, 0xb6, 0xb6, 0x6e, 0xa4, 0xf1, 0x06, 0x08,
      0xc6, 0xd7, 0x99, 0xb0, 0x51, 0x51, 0x9f, 0xc8,
      0xe8, 0x9d, 0xe0, 0x0c, 0xdc, 0x55, 0x63, 0x50,
      0xa7, 0xd9, 0x66, 0x47, 0x50, 0x86, 0xf9, 0xaf :] #)
  vector2: _TEST_ kbkdf_cmac(mk128(ki2`seq),2,0,fixedinputdata2,nil_bytes,64)`data = ko2
END cmac_kdf_examples
