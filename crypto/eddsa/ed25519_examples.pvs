% RFC 8032 section 7.1, TEST 1. https://www.rfc-editor.org/rfc/rfc8032#section-7.1
ed25519_examples: THEORY
BEGIN
  IMPORTING ed25519
  empty_message: octets_of(0) = fill_octets(0, 0)
  seed: octets_of(32) =
    (# length := 32, seq := [: 0x9d, 0x61, 0xb1, 0x9d, 0xef, 0xfd, 0x5a, 0x60,
      0xba, 0x84, 0x4a, 0xf4, 0x92, 0xec, 0x2c, 0xc4,
      0x44, 0x49, 0xc5, 0x69, 0x7b, 0x32, 0x69, 0x19,
      0x70, 0x3b, 0xac, 0x03, 0x1c, 0xae, 0x7f, 0x60 :] #)
  vk: octets_of(32) =
    (# length := 32, seq := [: 0xd7, 0x5a, 0x98, 0x01, 0x82, 0xb1, 0x0a, 0xb7,
      0xd5, 0x4b, 0xfe, 0xd3, 0xc9, 0x64, 0x07, 0x3a,
      0x0e, 0xe1, 0x72, 0xf3, 0xda, 0xa6, 0x23, 0x25,
      0xaf, 0x02, 0x1a, 0x68, 0xf7, 0x07, 0x51, 0x1a :] #)
  known_signature: octets_of(64) =
    (# length := 64, seq := [: 0xe5, 0x56, 0x43, 0x00, 0xc3, 0x60, 0xac, 0x72,
      0x90, 0x86, 0xe2, 0xcc, 0x80, 0x6e, 0x82, 0x8a,
      0x84, 0x87, 0x7f, 0x1e, 0xb8, 0xe5, 0xd9, 0x74,
      0xd8, 0x73, 0xe0, 0x65, 0x22, 0x49, 0x01, 0x55,
      0x5f, 0xb8, 0x82, 0x15, 0x90, 0xa3, 0x3b, 0xac,
      0xc6, 0x1e, 0x39, 0x70, 0x1c, 0xf9, 0xb4, 0x6b,
      0xd2, 0x5b, 0xf5, 0xf0, 0x59, 0x5b, 0xbe, 0x24,
      0x65, 0x51, 0x41, 0x43, 0x8e, 0x7a, 0x10, 0x0b :] #)
  derive_key: _TEST_ public_key(seed) = vk
  sign_message: _TEST_ sign(seed, empty_message) = known_signature
  accept_signature: _TEST_ verify(vk, empty_message, known_signature)
  reject_modified_message: _TEST_ NOT verify(vk, fill_octets(1, 0), known_signature)
  reject_s_equals_order: _TEST_
    NOT verify(vk, empty_message, join_octets(half(known_signature, FALSE), write_scalar(order)))
  reject_noncanonical_y: _TEST_ NOT decode_point(write_scalar(prime))`valid


  % RFC 8032 section 7.3, Ed25519ph over abc with the default empty context.
  ph_seed: octets_of(32) =
    (# length := 32, seq := [: 0x83, 0x3f, 0xe6, 0x24, 0x09, 0x23, 0x7b, 0x9d,
      0x62, 0xec, 0x77, 0x58, 0x75, 0x20, 0x91, 0x1e,
      0x9a, 0x75, 0x9c, 0xec, 0x1d, 0x19, 0x75, 0x5b,
      0x7d, 0xa9, 0x01, 0xb9, 0x6d, 0xca, 0x3d, 0x42 :] #)
  ph_vk: octets_of(32) =
    (# length := 32, seq := [: 0xec, 0x17, 0x2b, 0x93, 0xad, 0x5e, 0x56, 0x3b,
      0xf4, 0x93, 0x2c, 0x70, 0xe1, 0x24, 0x50, 0x34,
      0xc3, 0x54, 0x67, 0xef, 0x2e, 0xfd, 0x4d, 0x64,
      0xeb, 0xf8, 0x19, 0x68, 0x34, 0x67, 0xe2, 0xbf :] #)
  ph_sig: octets_of(64) =
    (# length := 64, seq := [: 0x98, 0xa7, 0x02, 0x22, 0xf0, 0xb8, 0x12, 0x1a,
      0xa9, 0xd3, 0x0f, 0x81, 0x3d, 0x68, 0x3f, 0x80,
      0x9e, 0x46, 0x2b, 0x46, 0x9c, 0x7f, 0xf8, 0x76,
      0x39, 0x49, 0x9b, 0xb9, 0x4e, 0x6d, 0xae, 0x41,
      0x31, 0xf8, 0x50, 0x42, 0x46, 0x3c, 0x2a, 0x35,
      0x5a, 0x20, 0x03, 0xd0, 0x62, 0xad, 0xf5, 0xaa,
      0xa1, 0x0b, 0x8c, 0x61, 0xe6, 0x36, 0x06, 0x2a,
      0xaa, 0xd1, 0x1c, 0x2a, 0x26, 0x08, 0x34, 0x06 :] #)
  ph_message: octets_of(3) =
    (# length := 3, seq := [: 0x61, 0x62, 0x63 :] #)
  prehash_signature: _TEST_ sign_ph(ph_seed, ph_message, empty_message) = ph_sig
  accept_prehash: _TEST_ verify_ph(ph_vk, ph_message, ph_sig, empty_message)
  reject_wrong_context: _TEST_ NOT verify_ph(ph_vk, ph_message, ph_sig, fill_octets(1, 0))
END ed25519_examples
