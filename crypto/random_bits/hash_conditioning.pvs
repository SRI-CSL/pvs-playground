% SP 800-90C §§3.2.1–3.2.2.2. This provider profile assumes each requested
% source octet carries eight assessed bits of entropy. An acquisition stream
% concatenates independent source blocks and the caller selects its source.
hash_conditioning: THEORY
BEGIN
  hmac: LIBRARY = "../hmac"
  crypto_prelude: LIBRARY = "../crypto_prelude"
  IMPORTING hmac@keyed_hash, crypto_prelude@crypto_random_buffers
  approved: TYPE = {h: keyed_hash.hash_id | h=2 OR h=3 OR h=4 OR h=6 OR h>=8}
  method: TYPE = below(3)
  condition(h:approved,f:method,key:octets_of(hash_bytes(h)),
            x:{b:hmac_input(h) | b`length+5<maxsize}):octets_of(hash_bytes(h)) =
    IF f=0 THEN hash_message(h,x)
    ELSIF f=1 THEN hmac(h,key,x)
    ELSE LET bits:uint32=8*hash_bytes(h),
             prefix:octets_of(5)=(# length:=5,seq:=LAMBDA(i:below(5)):
                IF i=0 THEN 1 ELSE be_byte32(bits,i-1) ENDIF #) IN
      hash_message(h,join_octets(prefix,x))
    ENDIF
  requested: TYPE = subrange(1,524288)
  output_bytes(n:requested): index = u32rshift(n+7,3)
  conditioned: TYPE = [# success:bool, data:bytestring #]
  failed:conditioned = (# success:=FALSE, data:=fill_octets(0,0) #)
  full_blocks(h:approved,f:method,key:octets_of(hash_bytes(h)),s:stream_id,n:requested,
              out:octets_of(output_bytes(n)),i:upto(out`length),base:uint32):RECURSIVE conditioned =
    IF i=out`length THEN
      LET rest=u32rem(n,8) IN (# success:=TRUE,data:=
        IF rest=0 OR i=0 THEN out ELSE out WITH
          [`seq(i-1):=u8and(out`seq(i-1),u8lshift(255,8-rest))] ENDIF #)
    ELSE LET d=hash_bytes(h), step:subrange(28,72)=d+8,a=entropy_bytes(step,s,base) IN
      IF NOT a`ok THEN failed ELSE
        LET block=condition(h,f,key,a`value), j:index=IF i+d>=out`length THEN out`length ELSE i+d ENDIF IN
          IF j<out`length AND base>u32minus(0xffffffff,step) THEN failed
          ELSE full_blocks(h,f,key,s,n,copy_octets(out,i,block,0),j,u32plus(base,step)) ENDIF
      ENDIF
    ENDIF MEASURE out`length-i
  full_entropy(h:approved,f:method,key:octets_of(hash_bytes(h)),s:stream_id,n:requested):conditioned =
    full_blocks(h,f,key,s,n,fill_octets(output_bytes(n),0),0,0)
  failed_empty: LEMMA failed`data`length=0 AND NOT failed`success
END hash_conditioning
