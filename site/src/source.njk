---
layout: base.njk
pagination:
  data: catalog.pages
  size: 1
  alias: source
permalink: "{{ source.output }}"
eleventyComputed:
  title: "{{ source.name }}"
  theme: "{{ source.theme }}"
eleventyExcludeFromCollections: true
---
{% set breadcrumbs = source.breadcrumbs %}
{% include "breadcrumbs.njk" %}
<div class="source-heading">
  <h1>{{ title }}</h1>
  {% if source.isPvs %}<a href="{{ source.rawUrl }}">Raw source</a>{% endif %}
</div>
{% if source.isPvs %}
  {% if source.prose %}
    <div class="prose">
      {% repositoryProse source.prose %}
    </div>
  {% endif %}
  {% pvsSource source %}
{% else %}
  <div class="prose">
    {% repositoryProse source %}
  </div>
{% endif %}
