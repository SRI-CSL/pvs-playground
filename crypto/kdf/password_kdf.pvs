% NIST SP 800-132, sections 5.1--5.3. https://doi.org/10.6028/NIST.SP.800-132
password_kdf: THEORY
BEGIN
  hmac: LIBRARY = "../hmac"
  IMPORTING hmac@keyed_hash

  % Account for the four-byte counter and the longest HMAC inner prefix.
  salt_buffer: TYPE = {s: bytestring | s`length + 148 < maxsize}
  % For the storage profile the caller supplies a salt including at least
  % 128 bits generated by an approved RBG (section 5.1).
  storage_salt: TYPE = {s: salt_buffer | s`length >= 16}

  int32_be(i: uint32): octets_of(4) =
    (# length := 4, seq := LAMBDA (j: below(4)): be_byte32(i, j) #)

  xor_digest(h: hash_id, a, b: octets_of(hash_bytes(h))): octets_of(hash_bytes(h)) =
    (# length := hash_bytes(h), seq := LAMBDA (j: below(hash_bytes(h))):
         u8xor(a`seq(j), b`seq(j)) #)

  % Section 5.3. prev is U_j, acc is the XOR of U_1 through U_j.
  prf_iterations(h: hash_id, password: bytestring, prev, acc: octets_of(hash_bytes(h)),
                 remaining: uint32): RECURSIVE octets_of(hash_bytes(h)) =
    IF remaining = 0 THEN acc
    ELSE LET next = hmac(h, password, prev)
         IN prf_iterations(h, password, next, xor_digest(h, acc, next), remaining - 1)
    ENDIF MEASURE remaining

  pbkdf_block(h: hash_id, password: bytestring, salt: salt_buffer,
              iterations, i: pos_uint32): octets_of(hash_bytes(h)) =
    LET u1 = hmac(h, password, join_octets(salt, int32_be(i)))
    IN prf_iterations(h, password, u1, u1, iterations - 1)

  % Generate once per digest-sized output block. The bounded buffer implies
  % fewer than 2^32 blocks for every permitted digest size.
  derive_from(h: hash_id, password: bytestring, salt: salt_buffer, iterations: pos_uint32,
              out: bytestring, at: upto(out`length)): RECURSIVE octets_of(out`length) =
    IF at = out`length THEN out
    ELSE LET block_number: pos_uint32 = 1 + u32div(at, hash_bytes(h)),
             block = pbkdf_block(h, password, salt, iterations, block_number),
             next = copy_octets(out, at, block, 0),
             after: index = IF at + hash_bytes(h) >= out`length THEN out`length
                            ELSE at + hash_bytes(h) ENDIF
         IN derive_from(h, password, salt, iterations, next, after)
    ENDIF MEASURE out`length - at

  pbkdf2(h: hash_id, password: bytestring, salt: salt_buffer, iterations: pos_uint32,
         n: index): octets_of(n) =
    derive_from(h, password, salt, iterations, fill_octets(n, 0), 0)

  % Storage application profile. Section 5 requires at least 112 output bits.
  storage_key(h: hash_id, password: bytestring, salt: storage_salt, iterations: pos_uint32,
              n: {l: index | l >= 14}): octets_of(n) = pbkdf2(h, password, salt, iterations, n)

  one_iteration: LEMMA FORALL (h: hash_id, p: bytestring, s: salt_buffer, i: pos_uint32):
    pbkdf_block(h, p, s, 1, i) = hmac(h, p, join_octets(s, int32_be(i)))
END password_kdf
