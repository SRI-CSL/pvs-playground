cbdd_array_pkg[
  nvars: {n: pos_uint32 | n <= 32},
  max_nodes: {m: pos_uint32 | 3 <= m AND m <= maxsize},
  unique_slots: {m: pos_uint32 | 1 <= m AND m <= maxsize},
  cache_slots: {m: pos_uint32 | 1 <= m AND m <= maxsize}
]: THEORY
BEGIN
  IMPORTING cbdd_array_core[nvars, max_nodes, unique_slots, cache_slots]

  IMPORTING bdd_interface{{
    bddvar := vid,
    valuation := cvaluation,
    cube := ccube,
    perm := cperm,
    bdd := cbdd,
    read_var := abdd_read_var,
    update_var := abdd_update_var,
    cube_support := abdd_cube_support,
    cube_value := abdd_cube_value,
    cube_empty := abdd_cube_empty,
    cube_insert := abdd_cube_insert,
    force_cube := abdd_force_cube,
    denote := cbdd_denote,
    support := cbdd_support,
    bdd_false := cbdd_false,
    bdd_true := cbdd_true,
    ithvar := cbdd_ithvar,
    nithvar := cbdd_nithvar,
    bdd_not := cbdd_not,
    bdd_and := cbdd_and,
    bdd_or := cbdd_or,
    bdd_xor := cbdd_xor,
    bdd_xnor := cbdd_xnor,
    bdd_nand := cbdd_nand,
    bdd_nor := cbdd_nor,
    bdd_imp := cbdd_imp,
    bdd_invimp := cbdd_invimp,
    bdd_diff := cbdd_diff,
    bdd_ite := cbdd_ite,
    bdd_exists := cbdd_exists,
    bdd_forall := cbdd_forall,
    bdd_and_abstract := cbdd_and_abstract,
    bdd_restrict := cbdd_restrict,
    bdd_constrain := cbdd_constrain,
    bdd_compose := cbdd_compose,
    permute_var := abdd_permute_var,
    inverse_perm := abdd_inverse_perm,
    permute_valuation := abdd_permute_valuation,
    bdd_permute := cbdd_permute,
    pick_sat := cbdd_pick_sat
  }}
END cbdd_array_pkg
