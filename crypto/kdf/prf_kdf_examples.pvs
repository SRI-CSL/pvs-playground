% NIST KBKDFVS COUNT=0, counter before fixed input (8-bit), feedback and
% double-pipeline without counter. The latter two request multiple output blocks.
% https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/key-derivation
prf_kdf_examples: THEORY
BEGIN
  IMPORTING establishment_kdf
  nil_bytes: octets_of(0) = fill_octets(0,0)
  ki0: octets_of(32) =
    (# length := 32, seq := [: 0x3e, 0xdc, 0x6b, 0x5b, 0x8f, 0x7a, 0xad, 0xbd,
      0x71, 0x37, 0x32, 0xb4, 0x82, 0xb8, 0xf9, 0x79,
      0x28, 0x6e, 0x1e, 0xa3, 0xb8, 0xf8, 0xf9, 0x9c,
      0x30, 0xc8, 0x84, 0xcf, 0xe3, 0x34, 0x9b, 0x83 :] #)
  fixedinputdata0: octets_of(60) =
    (# length := 60, seq := [: 0x98, 0xe9, 0x98, 0x8b, 0xb4, 0xcc, 0x8b, 0x34,
      0xd7, 0x92, 0x2e, 0x1c, 0x68, 0xad, 0x69, 0x2b,
      0xa2, 0xa1, 0xd9, 0xae, 0x15, 0x14, 0x95, 0x71,
      0x67, 0x5f, 0x17, 0xa7, 0x7a, 0xd4, 0x9e, 0x80,
      0xc8, 0xd2, 0xa8, 0x5e, 0x83, 0x1a, 0x26, 0x44,
      0x5b, 0x1f, 0x0f, 0xf4, 0x4d, 0x70, 0x84, 0xa1,
      0x72, 0x06, 0xb4, 0x89, 0x6c, 0x81, 0x12, 0xda,
      0xad, 0x18, 0x60, 0x5a :] #)
  ko0: octets_of(16) =
    (# length := 16, seq := [: 0x6c, 0x03, 0x76, 0x52, 0x99, 0x06, 0x74, 0xa0,
      0x78, 0x44, 0x73, 0x2d, 0x0a, 0xd9, 0x85, 0xf9 :] #)
  vector0: _TEST_ kbkdf(h_sha256,ki0,0,1,fixedinputdata0,nil_bytes,16)`data = ko0
  ki1: octets_of(32) =
    (# length := 32, seq := [: 0x4b, 0x02, 0xff, 0xb1, 0xcb, 0x99, 0x87, 0x49,
      0x6e, 0x19, 0x87, 0x25, 0x97, 0xb0, 0x26, 0xf7,
      0x40, 0x9d, 0x92, 0x43, 0x3f, 0x91, 0x35, 0x06,
      0x8c, 0x29, 0x30, 0x79, 0x85, 0x59, 0x85, 0x86 :] #)
  iv1: octets_of(32) =
    (# length := 32, seq := [: 0x5c, 0x2a, 0x22, 0x62, 0xd1, 0x49, 0x94, 0x90,
      0x4c, 0x9c, 0x2d, 0xe3, 0x6d, 0x66, 0xc7, 0xeb,
      0xda, 0xed, 0x32, 0xb5, 0xcc, 0x44, 0x1c, 0x22,
      0x22, 0x58, 0x85, 0x7f, 0x5a, 0xf2, 0x9b, 0xea :] #)
  fixedinputdata1: octets_of(51) =
    (# length := 51, seq := [: 0xa3, 0x8f, 0x30, 0x84, 0x41, 0x36, 0xc3, 0x3e,
      0x00, 0xd4, 0x25, 0x4a, 0x8b, 0xc5, 0xf5, 0x1e,
      0x84, 0x73, 0xac, 0x20, 0xe5, 0x62, 0x8e, 0x77,
      0xe4, 0xd9, 0x1a, 0x70, 0x4d, 0x58, 0xbf, 0x0d,
      0x4d, 0x0f, 0xef, 0xb5, 0xf9, 0x2d, 0x89, 0x7f,
      0x19, 0x58, 0xb0, 0xaf, 0x18, 0x81, 0x80, 0xb2,
      0xe2, 0xd2, 0xf7 :] #)
  ko1: octets_of(64) =
    (# length := 64, seq := [: 0xef, 0x46, 0xa7, 0xcc, 0x3f, 0x2f, 0xd3, 0xaa,
      0xc2, 0xd5, 0x5c, 0x73, 0x86, 0xb9, 0x92, 0x79,
      0x09, 0x8a, 0xd8, 0xaf, 0x07, 0xe1, 0x13, 0xc6,
      0x83, 0xe4, 0x36, 0x01, 0xd3, 0xe0, 0xc9, 0xa4,
      0x81, 0x65, 0xa5, 0x80, 0xd6, 0x0b, 0x9c, 0x2d,
      0xf7, 0x5c, 0xdf, 0xc0, 0x66, 0x85, 0x56, 0x07,
      0xc0, 0xdd, 0x51, 0xad, 0x8f, 0xc0, 0x29, 0x6c,
      0x3f, 0x72, 0xe8, 0x3d, 0x3d, 0x57, 0x42, 0xe2 :] #)
  vector1: _TEST_ kbkdf(h_sha256,ki1,1,0,fixedinputdata1,iv1,64)`data = ko1
  ki2: octets_of(32) =
    (# length := 32, seq := [: 0x7d, 0x4f, 0x86, 0xfd, 0xfd, 0x1c, 0x4b, 0xa0,
      0x4c, 0x67, 0x4a, 0x68, 0xd6, 0x03, 0x16, 0xd1,
      0x2c, 0x99, 0xc1, 0xb1, 0xf4, 0x4f, 0x0a, 0x8e,
      0x02, 0xbd, 0x26, 0x01, 0x37, 0x7e, 0xbc, 0xd9 :] #)
  fixedinputdata2: octets_of(51) =
    (# length := 51, seq := [: 0x92, 0x1a, 0xb0, 0x61, 0x92, 0x0b, 0x19, 0x1d,
      0xe1, 0x2f, 0x74, 0x6a, 0xc9, 0xde, 0x08, 0x00,
      0x4f, 0x2c, 0x20, 0xf0, 0x17, 0x75, 0xe2, 0x7b,
      0xca, 0xcd, 0xc2, 0x1e, 0xe4, 0xa5, 0xff, 0x03,
      0x87, 0x75, 0x8f, 0x36, 0xd8, 0xec, 0x71, 0xc7,
      0xa8, 0xc8, 0x20, 0x82, 0x84, 0xf6, 0x50, 0xb6,
      0x11, 0x83, 0x7e :] #)
  ko2: octets_of(64) =
    (# length := 64, seq := [: 0x50, 0x6b, 0xc2, 0xba, 0x51, 0x41, 0x0b, 0x2a,
      0x6e, 0x7c, 0x05, 0xd3, 0x38, 0x91, 0x52, 0x0d,
      0xdd, 0x5f, 0x70, 0x2a, 0xd3, 0xd6, 0x20, 0x3d,
      0x76, 0xd8, 0xda, 0xe1, 0x21, 0x6d, 0x07, 0x83,
      0xd8, 0xc5, 0x9f, 0xae, 0x2e, 0x82, 0x1d, 0x8e,
      0xff, 0x2d, 0x8d, 0xdd, 0x93, 0xa6, 0x74, 0x1c,
      0x8f, 0x14, 0x4f, 0xb9, 0x6e, 0x9c, 0xa7, 0xd7,
      0xc5, 0x32, 0x46, 0x8f, 0x21, 0x3f, 0x5e, 0xfe :] #)
  vector2: _TEST_ kbkdf(h_sha256,ki2,2,0,fixedinputdata2,nil_bytes,64)`data = ko2
  % Supplemental SHA-256, HMAC-SHA-256 and KMAC128 derivations with default salt.
  shared_z: octets_of(32) =
    (# length := 32, seq := [: 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
      0x08, 0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x0e, 0x0f,
      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
      0x18, 0x19, 0x1a, 0x1b, 0x1c, 0x1d, 0x1e, 0x1f :] #)
  identity_info: octets_of(13) =
    (# length := 13, seq := [: 0x50, 0x61, 0x72, 0x74, 0x79, 0x55, 0x7c, 0x50,
      0x61, 0x72, 0x74, 0x79, 0x56 :] #)
  hash_answer: octets_of(35) =
    (# length := 35, seq := [: 0xd0, 0x42, 0x81, 0xd6, 0xa1, 0x36, 0x5d, 0xeb,
      0xd6, 0xf6, 0x2a, 0x4a, 0xeb, 0x68, 0xc3, 0x8b,
      0xfe, 0x8e, 0xdd, 0xfa, 0xd6, 0x22, 0xdd, 0x32,
      0x93, 0x70, 0xb8, 0x7d, 0x2c, 0x8b, 0x75, 0x7b,
      0x82, 0x5f, 0x37 :] #)
  one_step_hash: _TEST_ one_step(h_sha256,FALSE,nil_bytes,shared_z,identity_info,35)`data = hash_answer
  hmac_answer: octets_of(35) =
    (# length := 35, seq := [: 0x97, 0x63, 0xd1, 0xa3, 0x0c, 0xc2, 0xdb, 0x1e,
      0x28, 0x23, 0xfd, 0x30, 0xc7, 0x0f, 0x15, 0x87,
      0xbd, 0x23, 0x96, 0x1a, 0x39, 0x65, 0x28, 0xf9,
      0xaa, 0xf1, 0x74, 0x8b, 0x34, 0x29, 0x45, 0xa9,
      0x5e, 0x2f, 0xa3 :] #)
  one_step_hmac: _TEST_ one_step(h_sha256,TRUE,nil_bytes,shared_z,identity_info,35)`data = hmac_answer
  two_step_answer: octets_of(35) =
    (# length := 35, seq := [: 0x99, 0x14, 0x7c, 0xca, 0xf3, 0x0f, 0x29, 0x59,
      0x53, 0xe2, 0xcb, 0x56, 0xc0, 0xa7, 0xef, 0x0f,
      0x3c, 0x0c, 0x64, 0x66, 0xf0, 0xcf, 0xba, 0x0a,
      0x69, 0xf4, 0x15, 0xf7, 0x9c, 0x64, 0x83, 0x0b,
      0x1d, 0xb3, 0x8a :] #)
  extracted_key: _TEST_ two_step(h_sha256,nil_bytes,shared_z,counter_mode,4,identity_info,nil_bytes,35)`data = two_step_answer
  kmac_iterated_answer: octets_of(35) =
    (# length := 35, seq := [: 0x41, 0x5f, 0xdd, 0x85, 0xc7, 0x8c, 0x2c, 0x93,
      0xe6, 0x4c, 0x31, 0xd2, 0x73, 0x32, 0x2f, 0x0f,
      0xf4, 0x0a, 0x8f, 0xf3, 0x1d, 0x91, 0x4f, 0xf9,
      0x6b, 0xd7, 0x4d, 0x7c, 0x4c, 0x43, 0x35, 0x7e,
      0x0e, 0xc4, 0x3a :] #)
  kmac_iterated_example: _TEST_ one_step_kmac(128,nil_bytes,shared_z,identity_info,32,35)`data = kmac_iterated_answer
  kmac_l_answer: octets_of(35) =
    (# length := 35, seq := [: 0x1e, 0xea, 0xd7, 0xab, 0x4c, 0xba, 0x54, 0x15,
      0x94, 0xa9, 0x8b, 0xd4, 0x8f, 0x34, 0x8d, 0x8d,
      0xc4, 0x75, 0x6a, 0x3b, 0x00, 0x8c, 0xbb, 0xaa,
      0x8d, 0x92, 0x43, 0x59, 0x9a, 0x7d, 0x3e, 0x34,
      0x63, 0x6a, 0x1f :] #)
  kmac_l_example: _TEST_ one_step_kmac_l(128,nil_bytes,shared_z,identity_info,35) = kmac_l_answer
  kmac_key: octets_of(32) =
    (# length := 32, seq := [: 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47,
      0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f,
      0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57,
      0x58, 0x59, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e, 0x5f :] #)
  kmac_data: octets_of(4) =
    (# length := 4, seq := [: 0x00, 0x01, 0x02, 0x03 :] #)
  kmac_sample: octets_of(32) =
    (# length := 32, seq := [: 0xe5, 0x78, 0x0b, 0x0d, 0x3e, 0xa6, 0xf7, 0xd3,
      0xa4, 0x29, 0xc5, 0x70, 0x6a, 0xa4, 0x3a, 0x00,
      0xfa, 0xdb, 0xd7, 0xd4, 0x96, 0x28, 0x83, 0x9e,
      0x31, 0x87, 0x24, 0x3f, 0x45, 0x6e, 0xe1, 0x4e :] #)
  kbkdf_kmac_sample: _TEST_ kbkdf_kmac(128,octets(kmac_key),octets(kmac_data),octets(nil_bytes),32) = kmac_sample
  exhausted_counter: _TEST_ NOT kbkdf(h_sha256,ki0,counter_mode,1,fixedinputdata0,nil_bytes,8161)`ok
END prf_kdf_examples
