% NIST DRBGVS (CAVP) SHA-256, COUNT = 0, 256-bit entropy,
% 128-bit nonce, 256-bit personalization and additional input, 1024-bit output.
% https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/random-number-generators
hash_drbg_examples: THEORY
BEGIN
  IMPORTING hash_drbg

  % drbgvectors_pr_false.zip, Hash_DRBG.rsp.
  rs_entropy: octets_of(32) =
    (# length := 32, seq := [: 0x6c, 0x62, 0x3a, 0xea, 0x73, 0xbc, 0x8a, 0x59,
      0xe2, 0x8c, 0x6c, 0xd9, 0xc7, 0xc7, 0xec, 0x8c,
      0xa2, 0xe7, 0x51, 0x90, 0xbd, 0x5d, 0xca, 0xe5,
      0x97, 0x8c, 0xf0, 0xc1, 0x99, 0xc2, 0x3f, 0x4f :] #)
  rs_nonce: octets_of(16) =
    (# length := 16, seq := [: 0xe5, 0x5d, 0xb0, 0x67, 0xa0, 0xed, 0x53, 0x7e,
      0x66, 0x88, 0x6b, 0x7c, 0xda, 0x02, 0xf7, 0x72 :] #)
  rs_ps: octets_of(32) =
    (# length := 32, seq := [: 0x1e, 0x59, 0xd7, 0x98, 0x81, 0x00, 0x83, 0xd1,
      0xff, 0x84, 0x8e, 0x90, 0xb2, 0x5c, 0x99, 0x27,
      0xe3, 0xdf, 0xb5, 0x5a, 0x08, 0x88, 0xb0, 0x33,
      0x95, 0x66, 0xa9, 0xf9, 0xca, 0x75, 0x42, 0xdc :] #)
  rs_additional1: octets_of(32) =
    (# length := 32, seq := [: 0xdc, 0xb2, 0x2a, 0x5d, 0x9f, 0x14, 0x98, 0x58,
      0x63, 0x6f, 0x3e, 0xde, 0x22, 0x53, 0xe4, 0x19,
      0x81, 0x6f, 0xb7, 0xb1, 0x10, 0x31, 0x94, 0x45,
      0x1e, 0xd6, 0xa5, 0x73, 0xa8, 0xfe, 0x62, 0x71 :] #)
  rs_additional2: octets_of(32) =
    (# length := 32, seq := [: 0x8f, 0x9d, 0x5c, 0x78, 0xcd, 0xab, 0xc3, 0x2e,
      0x71, 0xac, 0x3b, 0x3c, 0x49, 0x23, 0x9c, 0xad,
      0xdf, 0x96, 0x05, 0x32, 0x50, 0xf4, 0xfd, 0x92,
      0x05, 0x6e, 0xfb, 0xd0, 0xbe, 0x48, 0x7d, 0x36 :] #)
  rs_new_seed: octets_of(32) =
    (# length := 32, seq := [: 0x9a, 0xb4, 0x01, 0x64, 0x74, 0x4c, 0x7d, 0x00,
      0xc7, 0x8b, 0x41, 0x96, 0xf6, 0xf9, 0x17, 0xec,
      0x33, 0xd7, 0x00, 0x30, 0xa0, 0x81, 0x2c, 0xd4,
      0x60, 0x6c, 0x5a, 0x25, 0x38, 0x75, 0x68, 0xa9 :] #)
  rs_reseed_data: octets_of(32) =
    (# length := 32, seq := [: 0x4e, 0x8b, 0xea, 0xd7, 0xcb, 0xba, 0x7a, 0x7b,
      0xc9, 0xae, 0x1e, 0x16, 0x17, 0x22, 0x2c, 0x41,
      0x39, 0x66, 0x13, 0x47, 0x59, 0x99, 0x50, 0xe7,
      0x22, 0x5d, 0x1e, 0x2f, 0xaa, 0x5d, 0x57, 0xf5 :] #)
  rs_expected_lo: octets_of(64) =
    (# length := 64, seq := [: 0x6e, 0x98, 0xa3, 0xb1, 0xf6, 0x86, 0xf6, 0xff,
      0xa7, 0x93, 0x55, 0xc9, 0xd8, 0xa5, 0xab, 0x7f,
      0x93, 0x31, 0x21, 0x59, 0xd5, 0x26, 0x59, 0xa2,
      0x29, 0x83, 0x15, 0xf1, 0x00, 0x07, 0xc7, 0x1a,
      0xda, 0xbc, 0x0b, 0x5c, 0xcb, 0x41, 0x64, 0xc0,
      0x94, 0x9f, 0xbd, 0xb2, 0x21, 0xb4, 0x3a, 0xcd,
      0xb6, 0x2b, 0xed, 0x30, 0x99, 0x59, 0x6f, 0x2d,
      0x7b, 0xd5, 0xd0, 0x04, 0x81, 0x73, 0xdd, 0x23 :] #)
  rs_expected_hi: octets_of(64) =
    (# length := 64, seq := [: 0x60, 0xa5, 0x43, 0xb2, 0x34, 0xab, 0x61, 0xa4,
      0x41, 0xdd, 0xb9, 0x29, 0x9a, 0xf8, 0x4c, 0xa4,
      0x5c, 0x6e, 0x61, 0x8f, 0xd5, 0x21, 0x36, 0x6d,
      0xbf, 0x50, 0x9d, 0x4e, 0xc0, 0x61, 0x74, 0xda,
      0x92, 0x43, 0x61, 0xd6, 0x42, 0xb1, 0x07, 0xe5,
      0x56, 0x4a, 0xc1, 0xb3, 0x23, 0x40, 0xdd, 0x2f,
      0x31, 0x58, 0xbf, 0x4c, 0x00, 0xbc, 0xb4, 0xdc,
      0xf1, 0x2c, 0x6d, 0x67, 0xaf, 0x4b, 0x74, 0xee :] #)
  rs_expected: octets_of(128) = join_octets(rs_expected_lo, rs_expected_hi)
  rs_initial: hash_state = hash_instantiate(h_sha256, rs_entropy, rs_nonce, rs_ps)
  rs_step1: hash_result = hash_generate(hash_reseed(rs_initial, rs_new_seed, rs_reseed_data), 1024, rs_additional1)
  rs_step2: hash_result = hash_generate(rs_step1`current, 1024, rs_additional2)
  reseed_vector: _TEST_ rs_step1`success AND rs_step2`success AND rs_step2`data = rs_expected
  % drbgvectors_pr_true.zip, Hash_DRBG.rsp.
  pr_entropy: octets_of(32) =
    (# length := 32, seq := [: 0x29, 0xe1, 0xa4, 0x27, 0x09, 0xb7, 0xe8, 0x4d,
      0xbe, 0x50, 0x78, 0x8f, 0xba, 0xd8, 0xcb, 0x60,
      0x9c, 0x12, 0x7e, 0xec, 0x32, 0x62, 0x63, 0x6a,
      0x51, 0x3f, 0xd9, 0x05, 0x9f, 0xb8, 0xba, 0xe4 :] #)
  pr_nonce: octets_of(16) =
    (# length := 16, seq := [: 0xf3, 0xa5, 0x21, 0xf2, 0x8d, 0xff, 0xbd, 0x97,
      0x57, 0x4c, 0x40, 0x5b, 0x69, 0xb6, 0x36, 0xad :] #)
  pr_ps: octets_of(32) =
    (# length := 32, seq := [: 0xc9, 0x9a, 0x11, 0x47, 0xd8, 0xdb, 0x40, 0x1f,
      0x4f, 0xcf, 0x76, 0x38, 0x67, 0x29, 0x67, 0x58,
      0xe2, 0x64, 0x04, 0xa3, 0x0a, 0x4a, 0x9f, 0xa4,
      0x96, 0xa7, 0x17, 0xf2, 0x1f, 0x5d, 0x74, 0x9b :] #)
  pr_additional1: octets_of(32) =
    (# length := 32, seq := [: 0x17, 0x25, 0x4e, 0xa3, 0x92, 0xae, 0xad, 0x0d,
      0xc9, 0x49, 0x92, 0xd8, 0x67, 0x81, 0x34, 0x97,
      0xd3, 0xfd, 0x6d, 0xc7, 0x66, 0x96, 0x67, 0x15,
      0x0a, 0xfe, 0x6c, 0x28, 0xa2, 0xb8, 0x99, 0x46 :] #)
  pr_additional2: octets_of(32) =
    (# length := 32, seq := [: 0x15, 0x7d, 0xde, 0x59, 0xce, 0xb2, 0xc6, 0x62,
      0xc8, 0x66, 0x5f, 0xbe, 0x62, 0x3e, 0xc7, 0x58,
      0x73, 0xfd, 0x0c, 0x5c, 0xcc, 0xe7, 0x9a, 0x9f,
      0x5b, 0x70, 0x98, 0xec, 0x8e, 0xd7, 0x7b, 0x67 :] #)
  pr_fresh1: octets_of(32) =
    (# length := 32, seq := [: 0xd5, 0x26, 0x6c, 0x01, 0xe1, 0x0d, 0x72, 0xdd,
      0x7e, 0x8a, 0x3b, 0xf7, 0x17, 0xcc, 0xcb, 0x8f,
      0x64, 0x3c, 0xa2, 0x33, 0x31, 0x4e, 0x3e, 0x74,
      0xf1, 0x06, 0xf4, 0x6b, 0x09, 0x0e, 0x5c, 0x73 :] #)
  pr_fresh2: octets_of(32) =
    (# length := 32, seq := [: 0xc7, 0xe5, 0xf0, 0x3d, 0x26, 0xbd, 0xf9, 0x55,
      0x33, 0x38, 0xe6, 0x4b, 0xa6, 0x4c, 0xe5, 0xb5,
      0x75, 0x1b, 0x04, 0xf9, 0xc6, 0x99, 0x92, 0x22,
      0x14, 0x95, 0xf2, 0x22, 0x7b, 0x97, 0x99, 0xd0 :] #)
  pr_expected_lo: octets_of(64) =
    (# length := 64, seq := [: 0xe3, 0x04, 0xde, 0x9f, 0xfd, 0x88, 0x5c, 0xf9,
      0x17, 0xea, 0xd7, 0x8f, 0x05, 0x93, 0x9b, 0x8c,
      0xf5, 0x47, 0x09, 0xfc, 0x2d, 0x0c, 0x79, 0x9a,
      0x98, 0xb5, 0x43, 0x48, 0x63, 0x37, 0x20, 0x44,
      0x77, 0xb1, 0x06, 0x0b, 0xce, 0xae, 0x2a, 0x22,
      0xf7, 0xff, 0x42, 0xb6, 0xcb, 0x4b, 0x4b, 0xc0,
      0x61, 0x0a, 0xe2, 0xb6, 0x75, 0x58, 0xa7, 0xc5,
      0x4b, 0x65, 0xe4, 0x5b, 0xb9, 0xf1, 0xa8, 0x69 :] #)
  pr_expected_hi: octets_of(64) =
    (# length := 64, seq := [: 0x81, 0xb7, 0x47, 0x05, 0xb4, 0x8c, 0xdb, 0xf7,
      0xd8, 0xde, 0xcf, 0x87, 0x86, 0x82, 0x67, 0xbd,
      0x94, 0x8e, 0x93, 0x94, 0xaa, 0x43, 0x57, 0xf8,
      0xdb, 0xbf, 0x30, 0x61, 0x2a, 0x0e, 0xb5, 0xb1,
      0x31, 0x88, 0x4c, 0x22, 0x0e, 0x44, 0x2d, 0x36,
      0x77, 0x8e, 0x8d, 0x74, 0x09, 0x1d, 0x8a, 0x27,
      0xc0, 0x70, 0xfe, 0x69, 0x04, 0x69, 0xe0, 0x7f,
      0x3a, 0xab, 0xee, 0xf7, 0xc6, 0x29, 0xbf, 0xab :] #)
  pr_expected: octets_of(128) = join_octets(pr_expected_lo, pr_expected_hi)
  pr_initial: hash_state = hash_instantiate(h_sha256, pr_entropy, pr_nonce, pr_ps)
  pr_step1: hash_result = hash_reseed_generate(pr_initial, pr_fresh1, pr_additional1, 1024)
  pr_step2: hash_result = hash_reseed_generate(pr_step1`current, pr_fresh2, pr_additional2, 1024)
  prediction_resistance_vector: _TEST_ pr_step1`success AND pr_step2`success AND pr_step2`data = pr_expected
END hash_drbg_examples
