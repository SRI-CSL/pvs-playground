% NIST Examples with Intermediate Values, HMAC_SHA256.pdf and HMAC_DRBG.pdf.
% https://csrc.nist.gov/projects/cryptographic-standards-and-guidelines/example-values
hmac_examples: THEORY
BEGIN
  IMPORTING hmac_drbg
  ramp(n: uint8, base: uint8): octets_of(n) =
    (# length := n, seq := LAMBDA (i: below(n)): u8plus(base, i) #)
  empty: octets_of(0) = fill_octets(0, 0)

  message_eq: octets_of(34) =
    (# length := 34, seq := [: 0x53, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x20, 0x6d,
      0x65, 0x73, 0x73, 0x61, 0x67, 0x65, 0x20, 0x66,
      0x6f, 0x72, 0x20, 0x6b, 0x65, 0x79, 0x6c, 0x65,
      0x6e, 0x3d, 0x62, 0x6c, 0x6f, 0x63, 0x6b, 0x6c,
      0x65, 0x6e :] #)
  message_lt: octets_of(34) =
    (# length := 34, seq := [: 0x53, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x20, 0x6d,
      0x65, 0x73, 0x73, 0x61, 0x67, 0x65, 0x20, 0x66,
      0x6f, 0x72, 0x20, 0x6b, 0x65, 0x79, 0x6c, 0x65,
      0x6e, 0x3c, 0x62, 0x6c, 0x6f, 0x63, 0x6b, 0x6c,
      0x65, 0x6e :] #)
  short_tag: octets_of(32) =
    (# length := 32, seq := [: 0xa2, 0x8c, 0xf4, 0x31, 0x30, 0xee, 0x69, 0x6a,
      0x98, 0xf1, 0x4a, 0x37, 0x67, 0x8b, 0x56, 0xbc,
      0xfc, 0xbd, 0xd9, 0xe5, 0xcf, 0x69, 0x71, 0x7f,
      0xec, 0xf5, 0x48, 0x0f, 0x0e, 0xbd, 0xf7, 0x90 :] #)
  short_key: _TEST_ hmac(h_sha256, ramp(32, 0), message_lt) = short_tag

  block_tag: octets_of(32) =
    (# length := 32, seq := [: 0x8b, 0xb9, 0xa1, 0xdb, 0x98, 0x06, 0xf2, 0x0d,
      0xf7, 0xf7, 0x7b, 0x82, 0x13, 0x8c, 0x79, 0x14,
      0xd1, 0x74, 0xd5, 0x9e, 0x13, 0xdc, 0x4d, 0x01,
      0x69, 0xc9, 0x05, 0x7b, 0x13, 0x3e, 0x1d, 0x62 :] #)
  block_key: _TEST_ hmac(h_sha256, ramp(64, 0), message_eq) = block_tag

  long_tag: octets_of(32) =
    (# length := 32, seq := [: 0xbd, 0xcc, 0xb6, 0xc7, 0x2d, 0xde, 0xad, 0xb5,
      0x00, 0xae, 0x76, 0x83, 0x86, 0xcb, 0x38, 0xcc,
      0x41, 0xc6, 0x3d, 0xbb, 0x08, 0x78, 0xdd, 0xb9,
      0xc7, 0xa3, 0x8a, 0x43, 0x1b, 0x78, 0x37, 0x8d :] #)
  long_key: _TEST_ hmac(h_sha256, ramp(100, 0), message_eq) = long_tag

  % HMAC_DRBG.pdf, SHA-256, PDF pages 148--154, first two 512-bit requests.
  output_one: octets_of(64) =
    (# length := 64, seq := [: 0xd6, 0x7b, 0x8c, 0x17, 0x34, 0xf4, 0x6f, 0xa3,
      0xf7, 0x63, 0xcf, 0x57, 0xc6, 0xf9, 0xf4, 0xf2,
      0xdc, 0x10, 0x89, 0xbd, 0x8b, 0xc1, 0xf6, 0xf0,
      0x23, 0x95, 0x0b, 0xfc, 0x56, 0x17, 0x63, 0x52,
      0x08, 0xc8, 0x50, 0x12, 0x38, 0xad, 0x7a, 0x44,
      0x00, 0xde, 0xfe, 0xe4, 0x6c, 0x64, 0x0b, 0x61,
      0xaf, 0x77, 0xc2, 0xd1, 0xa3, 0xbf, 0xaa, 0x90,
      0xed, 0xe5, 0xd2, 0x07, 0x40, 0x6e, 0x54, 0x03 :] #)
  output_two: octets_of(64) =
    (# length := 64, seq := [: 0x8f, 0xda, 0xec, 0x20, 0xf8, 0xb4, 0x21, 0x40,
      0x70, 0x59, 0xe3, 0x58, 0x89, 0x20, 0xda, 0x7e,
      0xda, 0x9d, 0xce, 0x3c, 0xf8, 0x27, 0x4d, 0xfa,
      0x1c, 0x59, 0xc1, 0x08, 0xc1, 0xd0, 0xaa, 0x9b,
      0x0f, 0xa3, 0x8d, 0xa5, 0xc7, 0x92, 0x03, 0x7c,
      0x4d, 0x33, 0xcd, 0x07, 0x0c, 0xa7, 0xcd, 0x0c,
      0x56, 0x08, 0xdb, 0xa8, 0xb8, 0x85, 0x65, 0x46,
      0x39, 0xde, 0x21, 0x87, 0xb7, 0x4c, 0xb2, 0x63 :] #)
  initial_state: state = instantiate(h_sha256, ramp(55, 0), ramp(8, 0x20), empty)
  first_step: result = generate(initial_state, 512, empty)
  second_step: result = generate(first_step`current, 512, empty)
  first_output: _TEST_ first_step`success AND first_step`data = output_one
  second_output: _TEST_ second_step`success AND second_step`data = output_two
END hmac_examples
