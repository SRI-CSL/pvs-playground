      0x60, 0x14, 0x53, 0xcd, 0xa3, 0x29, 0x3b, 0x17 :] #)
  ans_256_df: octets_of(64) =
    (# length := 64, seq := [: 0x1a, 0x6d, 0x8d, 0xbd, 0x64, 0x20, 0x76, 0xd1,
      0x39, 0x16, 0xe5, 0xe2, 0x30, 0x38, 0xb6, 0x0b,
      0x26, 0x06, 0x1f, 0x13, 0xdd, 0x4e, 0x00, 0x62,
      0x77, 0xe0, 0x26, 0x86, 0x98, 0xff, 0xb2, 0xc8,
      0x7e, 0x45, 0x3b, 0xae, 0x12, 0x51, 0x63, 0x1a,
      0xc9, 0x0c, 0x70, 0x1a, 0x98, 0x49, 0xd9, 0x33,
      0x99, 0x5e, 0x8b, 0x02, 0x21, 0xfe, 0x9a, 0xca,
      0x19, 0x85, 0xc5, 0x46, 0xc2, 0x07, 0x90, 0x27 :] #)
  init_256_df: state_for(2,TRUE) =
    instantiate_df(2,ee_256_df,non_256_df,per_256_df)
  reseeded_256_df: state_for(2,TRUE) =
    ctr_reseed_df(init_256_df,rse_256_df,rsi_256_df)
  first_256_df: results_for(2,TRUE) = ctr_generate(reseeded_256_df,512,add0_256_df)
  second_256_df: results_for(2,TRUE) = ctr_generate(first_256_df`current,512,add1_256_df)
  cavp_256_df: _TEST_ second_256_df`success AND second_256_df`data=ans_256_df

END ctr_drbg_examples
