---
layout: base.njk
pagination:
  data: catalog.pages
  size: 1
  alias: source
permalink: "{{ source.output }}"
eleventyComputed:
  title: "{{ source.name }}"
  theme: "{{ source.theme }}"
eleventyExcludeFromCollections: true
---
{% set breadcrumbs = source.breadcrumbs %}
{% include "breadcrumbs.njk" %}
<div class="source-heading">
  <h1>{{ title }}</h1>
  {% if source.isPvs %}
  <div class="source-links">
    {% set generated = source.path | generatedFor %}
    {% if generated %}<a href="{{ generated.url }}">Generated C</a>{% endif %}
    <a href="{{ source.rawUrl }}">Raw source</a>
  </div>
  {% endif %}
</div>
{% set runners = source.path | runnersFor(true) %}
{% include "crypto-runner.njk" %}
{% if source.isPvs %}
  {% if source.prose %}
    <div class="prose">
      {% repositoryProse source.prose %}
    </div>
  {% endif %}
  {% pvsSource source %}
{% else %}
  <div class="prose">
    {% repositoryProse source %}
  </div>
{% endif %}
