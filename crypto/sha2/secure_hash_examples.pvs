% NIST Examples with Intermediate Values, SHA_All.pdf, one-block "abc" examples.
% https://csrc.nist.gov/CSRC/media/Projects/Cryptographic-Standards-and-Guidelines/documents/examples/SHA_All.pdf
secure_hash_examples: THEORY
BEGIN
  IMPORTING secure_hash
  abc: digest_bytes(3) = (# length := 3, seq := [: 0x61, 0x62, 0x63 :] #)

  sha1_expected: digest_bytes(20) =
    (# length := 20, seq := [: 0xa9, 0x99, 0x3e, 0x36, 0x47, 0x06, 0x81, 0x6a,
      0xba, 0x3e, 0x25, 0x71, 0x78, 0x50, 0xc2, 0x6c,
      0x9c, 0xd0, 0xd8, 0x9d :] #)
  sha1_abc: _TEST_ sha1(abc) = sha1_expected

  sha224_expected: digest_bytes(28) =
    (# length := 28, seq := [: 0x23, 0x09, 0x7d, 0x22, 0x34, 0x05, 0xd8, 0x22,
      0x86, 0x42, 0xa4, 0x77, 0xbd, 0xa2, 0x55, 0xb3,
      0x2a, 0xad, 0xbc, 0xe4, 0xbd, 0xa0, 0xb3, 0xf7,
      0xe3, 0x6c, 0x9d, 0xa7 :] #)
  sha224_abc: _TEST_ sha224(abc) = sha224_expected

  sha256_expected: digest_bytes(32) =
    (# length := 32, seq := [: 0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
      0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
      0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
      0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad :] #)
  sha256_abc: _TEST_ sha256(abc) = sha256_expected

  sha384_expected: digest_bytes(48) =
    (# length := 48, seq := [: 0xcb, 0x00, 0x75, 0x3f, 0x45, 0xa3, 0x5e, 0x8b,
      0xb5, 0xa0, 0x3d, 0x69, 0x9a, 0xc6, 0x50, 0x07,
      0x27, 0x2c, 0x32, 0xab, 0x0e, 0xde, 0xd1, 0x63,
      0x1a, 0x8b, 0x60, 0x5a, 0x43, 0xff, 0x5b, 0xed,
      0x80, 0x86, 0x07, 0x2b, 0xa1, 0xe7, 0xcc, 0x23,
      0x58, 0xba, 0xec, 0xa1, 0x34, 0xc8, 0x25, 0xa7 :] #)
  sha384_abc: _TEST_ sha384(abc) = sha384_expected

  sha512_expected: digest_bytes(64) =
    (# length := 64, seq := [: 0xdd, 0xaf, 0x35, 0xa1, 0x93, 0x61, 0x7a, 0xba,
      0xcc, 0x41, 0x73, 0x49, 0xae, 0x20, 0x41, 0x31,
      0x12, 0xe6, 0xfa, 0x4e, 0x89, 0xa9, 0x7e, 0xa2,
      0x0a, 0x9e, 0xee, 0xe6, 0x4b, 0x55, 0xd3, 0x9a,
      0x21, 0x92, 0x99, 0x2a, 0x27, 0x4f, 0xc1, 0xa8,
      0x36, 0xba, 0x3c, 0x23, 0xa3, 0xfe, 0xeb, 0xbd,
      0x45, 0x4d, 0x44, 0x23, 0x64, 0x3c, 0xe8, 0x0e,
      0x2a, 0x9a, 0xc9, 0x4f, 0xa5, 0x4c, 0xa4, 0x9f :] #)
  sha512_abc: _TEST_ sha512(abc) = sha512_expected

  sha512_224_expected: digest_bytes(28) =
    (# length := 28, seq := [: 0x46, 0x34, 0x27, 0x0f, 0x70, 0x7b, 0x6a, 0x54,
      0xda, 0xae, 0x75, 0x30, 0x46, 0x08, 0x42, 0xe2,
      0x0e, 0x37, 0xed, 0x26, 0x5c, 0xee, 0xe9, 0xa4,
      0x3e, 0x89, 0x24, 0xaa :] #)
  sha512_224_abc: _TEST_ sha512_224(abc) = sha512_224_expected

  sha512_256_expected: digest_bytes(32) =
    (# length := 32, seq := [: 0x53, 0x04, 0x8e, 0x26, 0x81, 0x94, 0x1e, 0xf9,
      0x9b, 0x2e, 0x29, 0xb7, 0x6b, 0x4c, 0x7d, 0xab,
      0xe4, 0xc2, 0xd0, 0xc6, 0x34, 0xfc, 0x6d, 0x46,
      0xe0, 0xe2, 0xf1, 0x31, 0x07, 0xe7, 0xaf, 0x23 :] #)
  sha512_256_abc: _TEST_ sha512_256(abc) = sha512_256_expected

END secure_hash_examples
