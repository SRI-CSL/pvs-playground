bytevectors[n : index] 	: THEORY

  BEGIN

   %Vectors go from 0...n-1, and so right rotate by i moves 0->i, 1->i+1, .., n-1 -> n + i - 1.
   %left rotation moves 0 to n - i mod n.
   %To rotate by i, we first rotate i mod 8 bytes, and then nrem(i, 8) bits. 

   IMPORTING crypto_octets
   byv: TYPE = crypto_octets.byv[n]
   X, Y, Z: VAR byv

   byvand(X, Y): byv = (LAMBDA (i: below(n)): u8and(X(i), Y(i)))
   byvor(X, Y): byv =  (LAMBDA (i: below(n)): u8or(X(i), Y(i)))
   byvxor(X, Y): byv = xor_octets(n)(X, Y)
   byvnot(X): byv =  (LAMBDA (i: below(n)): u8not(X(i)))

   byvleftrot(X, (i: upto(n))): byv
     = (LAMBDA (j: below(n)): X(nrem(u32plus(i, j), n)))

   nextindex(i: below(n)): below(n) =
     (LET j = u32plus(i, 1)
        IN IF j = n then 0 ELSE j ENDIF)

   precindex(i: below(n)): below(n) =
      (IF i = 0 then u32minus(n, 1) ELSE u32minus(i, 1) ENDIF)

   byvrightrot(X, (i: upto(n))): byv
     = (LAMBDA (j: below(n)): X(u32rem(j + n - i, n)))


   % The first octet holds the most significant byte.
   byvbitleftrot(X, (i: upto(8))): byv =
     LAMBDA (j: below(n)): u8or(u8lshift(X(j), i),
                                  u8rshift(X(nextindex(j)), 8 - i))

   byvbitrightrot(X, (i: upto(8))): byv =
     LAMBDA (j: below(n)): u8or(u8rshift(X(j), i),
                                  u8lshift(X(precindex(j)), 8 - i))

   byvleftrotate(X, (i: {k: uint32 | k < 8 * n})): byv =
     byvbitleftrot(byvleftrot(X, u32div(i, 8)), u32rem(i, 8))

   byvrightrotate(X, (i: {k: uint32 | k < 8 * n})): byv =
     byvbitrightrot(byvrightrot(X, u32div(i, 8)), u32rem(i, 8))

   byvXOR(X, Y): byv = xor_octets(n)(X, Y)

   byv2bytestring(X): bytestring = (# length := n, seq := X #)

   byvlshft(X, (i : upto(n))) : byv
    = (LAMBDA (j : below(n)) :
         LET idx = u32plus(i, j) IN
	 IF idx >= n THEN 0 ELSE X(idx) ENDIF)

   byvrshft(X, (i: upto(n))): byv =
     LAMBDA (j: below(n)): IF j < i THEN 0 ELSE X(j - i) ENDIF

  byvbitleftshift(X, (i : upto(8))) : byv =
  (LAMBDA (j : below(n)) : % this is what the j'th value looks like
    IF j = n - 1
    THEN u8lshift(X(j), i)
    ELSE u8plus(u8lshift(X(j), i), u8rshift(X(j + 1), u8minus(8, i)))
    ENDIF)


  byvbitrightshift(X, (i : upto(8))) : byv =
  (LAMBDA (j : below(n)) : % this is what the j'th value looks like
    IF j = 0
    THEN u8rshift(X(j), i)
    ELSE u8plus(u8rshift(X(j), i), u8lshift(X(j - 1), u8minus(8, i)))
    ENDIF)

  byvleftshift(X, (i: {k: uint32 | k < 8 * n})): byv =
    byvbitleftshift(byvlshft(X, ndiv(i, 8)), nrem(i, 8))

  byvrightshift(X, (i: {k: uint32 | k < 8 * n})): byv =
    byvbitrightshift(byvrshft(X, ndiv(i, 8)), nrem(i, 8))


   CONVERSION+ byv2bytestring


  END bytevectors

byvconcat[m, n: index]: THEORY
BEGIN
  ASSUMING
   index_sum: ASSUMPTION m + n <= maxindex
  ENDASSUMING
  IMPORTING bytevectors
  ++(X: byv[m], Y: byv[n]): byv[m+n] =
   (LAMBDA (j: below(m + n)): IF j < m THEN X(j) ELSE Y(j - m) ENDIF)

END byvconcat

test_bytevectors: THEORY
BEGIN
  IMPORTING bytevectors%, byvconcat

     IMPORTING hex

   test1(i: below(64)): hexstring =
    (LET str = hex2bytestring("ABCDEF0123456789")
      IN bytestring2hexstring(str WITH [`seq :=  byvrightrotate(str`seq, i)]))

   test2: hexstring =
      (LET str1 = hex2bytestring("ABCDEF"),
           str2 = hex2bytestring("0123456789")
	IN bytestring2hexstring(str1 ++ str2))




END test_bytevectors
