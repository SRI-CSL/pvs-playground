---
layout: base.njk
pagination:
  data: catalog.directories
  size: 1
  alias: directory
permalink: "{{ directory.output }}"
eleventyComputed:
  title: "{{ directory.name }}"
  theme: "{{ directory.theme }}"
eleventyExcludeFromCollections: true
---
{% if theme == "crypto" %}
  {% set breadcrumbs = directory.breadcrumbs %}
{% else %}
  {% set breadcrumbs = directory.breadcrumbs.slice(0, -1) %}
{% endif %}
{% include "breadcrumbs.njk" %}
<h1>{{ title }}{% if theme != "crypto" %}/{% endif %}</h1>
<ul class="entries{% if theme == "crypto" %} crypto-entries{% endif %}">
  {% for folder in directory.folders %}
    <li><a href="{{ folder.url }}">{{ folder.name }}/</a></li>
  {% endfor %}
  {% for file in directory.files %}
    <li><a href="{{ file.url }}">{{ file.name }}</a></li>
  {% endfor %}
</ul>
{% if directory.readme %}
  <div class="prose readme">
    {% repositoryProse directory.readme %}
  </div>
{% endif %}
