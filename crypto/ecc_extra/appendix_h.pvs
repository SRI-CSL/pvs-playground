% SP 800-186 Appendix H, RFC 5639 §3 and SEC 2 v2 §2.4.1.
appendix_h: THEORY
BEGIN
  crypto_prelude: LIBRARY = "../crypto_prelude"
  IMPORTING crypto_prelude@crypto_limbs
  curve: TYPE = below(11)
  brainpoolP224r1: curve = 0
  brainpoolP224t1: curve = 1
  brainpoolP256r1: curve = 2
  brainpoolP256t1: curve = 3
  brainpoolP320r1: curve = 4
  brainpoolP320t1: curve = 5
  brainpoolP384r1: curve = 6
  brainpoolP384t1: curve = 7
  brainpoolP512r1: curve = 8
  brainpoolP512t1: curve = 9
  secp256k1: curve = 10
  width(c: curve): subrange(7,16) =
    IF c<2 THEN 7 ELSIF c<4 THEN 8 ELSIF c<6 THEN 10 ELSIF c<8 THEN 12
    ELSIF c<10 THEN 16 ELSE 8 ENDIF
  element(c: curve): TYPE = words_of(width(c))
  prime(c: curve): element(c) =
    IF c=0 THEN (# len:=7,word:=[: 0x7ec8c0ff,0x97da89f5,0xb09f0757,0x75d1d787,
                 0x2a183025,0x26436686,0xd7c134aa :] #)
    ELSIF c=1 THEN (# len:=7,word:=[: 0x7ec8c0ff,0x97da89f5,0xb09f0757,0x75d1d787,
                 0x2a183025,0x26436686,0xd7c134aa :] #)
    ELSIF c=2 THEN (# len:=8,word:=[: 0x1f6e5377,0x2013481d,0xd5262028,0x6e3bf623,
                 0x9d838d72,0x3e660a90,0xa1eea9bc,0xa9fb57db :] #)
    ELSIF c=3 THEN (# len:=8,word:=[: 0x1f6e5377,0x2013481d,0xd5262028,0x6e3bf623,
                 0x9d838d72,0x3e660a90,0xa1eea9bc,0xa9fb57db :] #)
    ELSIF c=4 THEN (# len:=10,word:=[: 0xf1b32e27,0xfcd412b1,0x7893ec28,0x4f92b9ec,
                 0xf6f40def,0xf98fcfa6,0xd201e065,0xe13c785e,
                 0x36bc4fb7,0xd35e4720 :] #)
    ELSIF c=5 THEN (# len:=10,word:=[: 0xf1b32e27,0xfcd412b1,0x7893ec28,0x4f92b9ec,
                 0xf6f40def,0xf98fcfa6,0xd201e065,0xe13c785e,
                 0x36bc4fb7,0xd35e4720 :] #)
    ELSIF c=6 THEN (# len:=12,word:=[: 0x3107ec53,0x87470013,0x901d1a71,0xacd3a729,
                 0x7fb71123,0x12b1da19,0xed5456b4,0x152f7109,
                 0x50e641df,0x0f5d6f7e,0xa3386d28,0x8cb91e82 :] #)
    ELSIF c=7 THEN (# len:=12,word:=[: 0x3107ec53,0x87470013,0x901d1a71,0xacd3a729,
                 0x7fb71123,0x12b1da19,0xed5456b4,0x152f7109,
                 0x50e641df,0x0f5d6f7e,0xa3386d28,0x8cb91e82 :] #)
    ELSIF c=8 THEN (# len:=16,word:=[: 0x583a48f3,0x28aa6056,0x2d82c685,0x2881ff2f,
                 0xe6a380e6,0xaecda12a,0x9bc66842,0x7d4d9b00,
                 0x70330871,0xd6639cca,0xb3c9d20e,0xcb308db3,
                 0x33c9fc07,0x3fd4e6ae,0xdbe9c48b,0xaadd9db8 :] #)
    ELSIF c=9 THEN (# len:=16,word:=[: 0x583a48f3,0x28aa6056,0x2d82c685,0x2881ff2f,
                 0xe6a380e6,0xaecda12a,0x9bc66842,0x7d4d9b00,
                 0x70330871,0xd6639cca,0xb3c9d20e,0xcb308db3,
                 0x33c9fc07,0x3fd4e6ae,0xdbe9c48b,0xaadd9db8 :] #)
    ELSE (# len:=8,word:=[: 0xfffffc2f,0xfffffffe,0xffffffff,0xffffffff,
                 0xffffffff,0xffffffff,0xffffffff,0xffffffff :] #)
    ENDIF
  coefficient_a(c: curve): element(c) =
