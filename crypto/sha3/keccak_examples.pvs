% NIST Examples with Intermediate Values, FIPS 202 and SP 800-185.
% https://csrc.nist.gov/projects/cryptographic-standards-and-guidelines/example-values
keccak_examples: THEORY
BEGIN
  IMPORTING sp800_185
  zeros(n: index): bytestring = (# length:=n, seq:=blank(n) #)
  empty: bytestring = zeros(0)

  sha3_224_empty_expected: bytestring =
    (# length:=28, seq:=[: 0x6b, 0x4e, 0x03, 0x42, 0x36, 0x67, 0xdb, 0xb7,
      0x3b, 0x6e, 0x15, 0x45, 0x4f, 0x0e, 0xb1, 0xab,
      0xd4, 0x59, 0x7f, 0x9a, 0x1b, 0x07, 0x8e, 0x3f,
      0x5b, 0x5a, 0x6b, 0xc7 :] #)
  sha3_224_empty: _TEST_ sha3_224(empty) = sha3_224_empty_expected

  sha3_256_empty_expected: bytestring =
    (# length:=32, seq:=[: 0xa7, 0xff, 0xc6, 0xf8, 0xbf, 0x1e, 0xd7, 0x66,
      0x51, 0xc1, 0x47, 0x56, 0xa0, 0x61, 0xd6, 0x62,
      0xf5, 0x80, 0xff, 0x4d, 0xe4, 0x3b, 0x49, 0xfa,
      0x82, 0xd8, 0x0a, 0x4b, 0x80, 0xf8, 0x43, 0x4a :] #)
  sha3_256_empty: _TEST_ sha3_256(empty) = sha3_256_empty_expected

  sha3_384_empty_expected: bytestring =
    (# length:=48, seq:=[: 0x0c, 0x63, 0xa7, 0x5b, 0x84, 0x5e, 0x4f, 0x7d,
      0x01, 0x10, 0x7d, 0x85, 0x2e, 0x4c, 0x24, 0x85,
      0xc5, 0x1a, 0x50, 0xaa, 0xaa, 0x94, 0xfc, 0x61,
      0x99, 0x5e, 0x71, 0xbb, 0xee, 0x98, 0x3a, 0x2a,
      0xc3, 0x71, 0x38, 0x31, 0x26, 0x4a, 0xdb, 0x47,
      0xfb, 0x6b, 0xd1, 0xe0, 0x58, 0xd5, 0xf0, 0x04 :] #)
  sha3_384_empty: _TEST_ sha3_384(empty) = sha3_384_empty_expected

  sha3_512_empty_expected: bytestring =
    (# length:=64, seq:=[: 0xa6, 0x9f, 0x73, 0xcc, 0xa2, 0x3a, 0x9a, 0xc5,
      0xc8, 0xb5, 0x67, 0xdc, 0x18, 0x5a, 0x75, 0x6e,
      0x97, 0xc9, 0x82, 0x16, 0x4f, 0xe2, 0x58, 0x59,
      0xe0, 0xd1, 0xdc, 0xc1, 0x47, 0x5c, 0x80, 0xa6,
      0x15, 0xb2, 0x12, 0x3a, 0xf1, 0xf5, 0xf9, 0x4c,
      0x11, 0xe3, 0xe9, 0x40, 0x2c, 0x3a, 0xc5, 0x58,
      0xf5, 0x00, 0x19, 0x9d, 0x95, 0xb6, 0xd3, 0xe3,
      0x01, 0x75, 0x85, 0x86, 0x28, 0x1d, 0xcd, 0x26 :] #)
  sha3_512_empty: _TEST_ sha3_512(empty) = sha3_512_empty_expected

  shake128_empty_expected: bytestring =
    (# length:=32, seq:=[: 0x7f, 0x9c, 0x2b, 0xa4, 0xe8, 0x8f, 0x82, 0x7d,
      0x61, 0x60, 0x45, 0x50, 0x76, 0x05, 0x85, 0x3e,
      0xd7, 0x3b, 0x80, 0x93, 0xf6, 0xef, 0xbc, 0x88,
      0xeb, 0x1a, 0x6e, 0xac, 0xfa, 0x66, 0xef, 0x26 :] #)
  shake128_empty: _TEST_ shake128(empty,32) = shake128_empty_expected

  shake256_empty_expected: bytestring =
    (# length:=32, seq:=[: 0x46, 0xb9, 0xdd, 0x2b, 0x0b, 0xa8, 0x8d, 0x13,
      0x23, 0x3b, 0x3f, 0xeb, 0x74, 0x3e, 0xeb, 0x24,
      0x3f, 0xcd, 0x52, 0xea, 0x62, 0xb8, 0x1b, 0x82,
      0xb5, 0x0c, 0x27, 0x64, 0x6e, 0xd5, 0x76, 0x2f :] #)
  shake256_empty: _TEST_ shake256(empty,32) = shake256_empty_expected

  sha3_256_five_bits_expected: bytestring =
    (# length:=32, seq:=[: 0x7b, 0x00, 0x47, 0xcf, 0x5a, 0x45, 0x68, 0x82,
      0x36, 0x3c, 0xbf, 0x0f, 0xb0, 0x53, 0x22, 0xcf,
      0x65, 0xf4, 0xb7, 0x05, 0x9a, 0x46, 0x36, 0x5e,
      0x83, 0x01, 0x32, 0xe3, 0xb5, 0xd9, 0x57, 0xaf :] #)
  sha3_256_five_bits: _TEST_ output(finish_sha3(absorb_low(start(136),0x13,5)),32) = sha3_256_five_bits_expected

  % SHA3-256_Msg1600.pdf uses 200 copies of 0xA3.
  repeated_a3: bytestring = (# length:=200, seq:=LAMBDA (i: below(200)): 0xA3 #)
  sha3_256_two_blocks_expected: bytestring =
    (# length:=32, seq:=[: 0x79, 0xf3, 0x8a, 0xde, 0xc5, 0xc2, 0x03, 0x07,
      0xa9, 0x8e, 0xf7, 0x6e, 0x83, 0x24, 0xaf, 0xbf,
      0xd4, 0x6c, 0xfd, 0x81, 0xb2, 0x2e, 0x39, 0x73,
      0xc6, 0x5f, 0xa1, 0xbd, 0x9d, 0xe3, 0x17, 0x87 :] #)
  sha3_256_two_blocks: _TEST_ sha3_256(repeated_a3) = sha3_256_two_blocks_expected

  % The 168th and 169th octets belong to successive output blocks.
  shake_cross_block: _TEST_ LET v=shake128(empty,172) IN v`length=172 AND
    v`seq(167)=0xa9 AND v`seq(168)=0x76 AND v`seq(171)=0xfd

  % SP 800-185 samples 1 for each function and sample 3 for cSHAKE256.
  email: bytestring =
    (# length:=15, seq:=[: 0x45, 0x6d, 0x61, 0x69, 0x6c, 0x20, 0x53, 0x69,
      0x67, 0x6e, 0x61, 0x74, 0x75, 0x72, 0x65 :] #)
  message: bytestring =
    (# length:=4, seq:=[: 0x00, 0x01, 0x02, 0x03 :] #)
  key: bytestring =
    (# length:=32, seq:=[: 0x40, 0x41, 0x42, 0x43, 0x44, 0x45, 0x46, 0x47,
      0x48, 0x49, 0x4a, 0x4b, 0x4c, 0x4d, 0x4e, 0x4f,
      0x50, 0x51, 0x52, 0x53, 0x54, 0x55, 0x56, 0x57,
      0x58, 0x59, 0x5a, 0x5b, 0x5c, 0x5d, 0x5e, 0x5f :] #)
  tuple_a: bytestring =
    (# length:=3, seq:=[: 0x00, 0x01, 0x02 :] #)
  tuple_b: bytestring =
    (# length:=6, seq:=[: 0x10, 0x11, 0x12, 0x13, 0x14, 0x15 :] #)
  leaves: bytestring =
    (# length:=24, seq:=[: 0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,
      0x10, 0x11, 0x12, 0x13, 0x14, 0x15, 0x16, 0x17,
      0x20, 0x21, 0x22, 0x23, 0x24, 0x25, 0x26, 0x27 :] #)
  e: packed = octets(empty)
  x: packed = octets(message)
  t: tuple_items = (# length:=2, items:=[: octets(tuple_a), octets(tuple_b) :] #)

  cshake128_sample_expected: bytestring =
    (# length:=32, seq:=[: 0xc1, 0xc3, 0x69, 0x25, 0xb6, 0x40, 0x9a, 0x04,
      0xf1, 0xb5, 0x04, 0xfc, 0xbc, 0xa9, 0xd8, 0x2b,
      0x40, 0x17, 0x27, 0x7c, 0xb5, 0xed, 0x2b, 0x20,
      0x65, 0xfc, 0x1d, 0x38, 0x14, 0xd5, 0xaa, 0xf5 :] #)
  cshake128_sample: _TEST_ output(cshake(128,x,e,octets(email)),32) = cshake128_sample_expected

  cshake256_sample_expected: bytestring =
    (# length:=64, seq:=[: 0xd0, 0x08, 0x82, 0x8e, 0x2b, 0x80, 0xac, 0x9d,
      0x22, 0x18, 0xff, 0xee, 0x1d, 0x07, 0x0c, 0x48,
      0xb8, 0xe4, 0xc8, 0x7b, 0xff, 0x32, 0xc9, 0x69,
      0x9d, 0x5b, 0x68, 0x96, 0xee, 0xe0, 0xed, 0xd1,
      0x64, 0x02, 0x0e, 0x2b, 0xe0, 0x56, 0x08, 0x58,
      0xd9, 0xc0, 0x0c, 0x03, 0x7e, 0x34, 0xa9, 0x69,
      0x37, 0xc5, 0x61, 0xa7, 0x4c, 0x41, 0x2b, 0xb4,
      0xc7, 0x46, 0x46, 0x95, 0x27, 0x28, 0x1c, 0x8c :] #)
  cshake256_sample: _TEST_ output(cshake(256,x,e,octets(email)),64) = cshake256_sample_expected

  kmac_sample_expected: bytestring =
    (# length:=32, seq:=[: 0xe5, 0x78, 0x0b, 0x0d, 0x3e, 0xa6, 0xf7, 0xd3,
      0xa4, 0x29, 0xc5, 0x70, 0x6a, 0xa4, 0x3a, 0x00,
      0xfa, 0xdb, 0xd7, 0xd4, 0x96, 0x28, 0x83, 0x9e,
      0x31, 0x87, 0x24, 0x3f, 0x45, 0x6e, 0xe1, 0x4e :] #)
  kmac_sample: _TEST_ output(kmac(128,octets(key),x,e,256),32) = kmac_sample_expected

  kmacxof_sample_expected: bytestring =
    (# length:=32, seq:=[: 0xcd, 0x83, 0x74, 0x0b, 0xbd, 0x92, 0xcc, 0xc8,
      0xcf, 0x03, 0x2b, 0x14, 0x81, 0xa0, 0xf4, 0x46,
      0x0e, 0x7c, 0xa9, 0xdd, 0x12, 0xb0, 0x8a, 0x0c,
      0x40, 0x31, 0x17, 0x8b, 0xac, 0xd6, 0xec, 0x35 :] #)
  kmacxof_sample: _TEST_ output(kmac(128,octets(key),x,e,0),32) = kmacxof_sample_expected

  tuplehash_sample_expected: bytestring =
    (# length:=32, seq:=[: 0xc5, 0xd8, 0x78, 0x6c, 0x1a, 0xfb, 0x9b, 0x82,
      0x11, 0x1a, 0xb3, 0x4b, 0x65, 0xb2, 0xc0, 0x04,
      0x8f, 0xa6, 0x4e, 0x6d, 0x48, 0xe2, 0x63, 0x26,
      0x4c, 0xe1, 0x70, 0x7d, 0x3f, 0xfc, 0x8e, 0xd1 :] #)
  tuplehash_sample: _TEST_ output(tuplehash(128,t,e,256),32) = tuplehash_sample_expected

  parallelhash_sample_expected: bytestring =
    (# length:=32, seq:=[: 0xba, 0x8d, 0xc1, 0xd1, 0xd9, 0x79, 0x33, 0x1d,
      0x3f, 0x81, 0x36, 0x03, 0xc6, 0x7f, 0x72, 0x60,
      0x9a, 0xb5, 0xe4, 0x4b, 0x94, 0xa0, 0xb8, 0xf9,
      0xaf, 0x46, 0x51, 0x44, 0x54, 0xa2, 0xb4, 0xf5 :] #)
  parallelhash_sample: _TEST_ output(parallelhash(128,octets(leaves),8,e,256),32) = parallelhash_sample_expected

  parallelhashxof_sample_expected: bytestring =
    (# length:=32, seq:=[: 0xfe, 0x47, 0xd6, 0x61, 0xe4, 0x9f, 0xfe, 0x5b,
      0x7d, 0x99, 0x99, 0x22, 0xc0, 0x62, 0x35, 0x67,
      0x50, 0xca, 0xf5, 0x52, 0x98, 0x5b, 0x8e, 0x8c,
      0xe6, 0x66, 0x7f, 0x27, 0x27, 0xc3, 0xc8, 0xd3 :] #)
  parallelhashxof_sample: _TEST_ output(parallelhash(128,octets(leaves),8,e,0),32) = parallelhashxof_sample_expected

END keccak_examples
