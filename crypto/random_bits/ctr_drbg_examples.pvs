% NIST DRBGVS drbgvectors_pr_false.zip, CTR_DRBG.rsp; COUNT = 0 with
% nonempty personalization, reseed additional input and two additional inputs.
% https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/random-number-generators
ctr_drbg_examples: THEORY
BEGIN
  IMPORTING ctr_drbg
  ee_128_direct: octets_of(32) =
    (# length := 32, seq := [: 0x28, 0x9e, 0x5c, 0x82, 0x83, 0xcb, 0xd7, 0xdb,
