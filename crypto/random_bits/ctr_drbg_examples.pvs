    instantiate_direct(2,ee_256_direct,per_256_direct)
  reseeded_256_direct: state_for(2,FALSE) =
    ctr_reseed_direct(init_256_direct,rse_256_direct,rsi_256_direct)
  first_256_direct: results_for(2,FALSE) = ctr_generate(reseeded_256_direct,512,add0_256_direct)
  second_256_direct: results_for(2,FALSE) = ctr_generate(first_256_direct`current,512,add1_256_direct)
  cavp_256_direct: _TEST_ second_256_direct`success AND second_256_direct`data=ans_256_direct

  ee_256_df: octets_of(32) =
    (# length := 32, seq := [: 0x17, 0x4b, 0x46, 0x25, 0x00, 0x51, 0xa9, 0xe3,
      0xd8, 0x0c, 0x56, 0xae, 0x71, 0x63, 0xda, 0xfe,
