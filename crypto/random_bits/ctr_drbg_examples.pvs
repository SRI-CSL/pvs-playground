      0x5c, 0xd6, 0x7d, 0x02, 0x49, 0x31, 0xc3, 0x3c,
      0xd1, 0x33, 0xd5, 0x2d, 0x5a, 0xe5, 0x00, 0xc3,
      0x01, 0x50, 0x20, 0xbe, 0xb3, 0x0d, 0xa0, 0x63 :] #)
  add0_256_df: octets_of(32) =
    (# length := 32, seq := [: 0xc7, 0x22, 0x8e, 0x90, 0xc6, 0x2f, 0x89, 0x6a,
      0x09, 0xe1, 0x16, 0x84, 0x53, 0x01, 0x02, 0xf9,
      0x26, 0xec, 0x90, 0xa3, 0x25, 0x5f, 0x6c, 0x21,
      0xb8, 0x57, 0x88, 0x3c, 0x75, 0x80, 0x01, 0x43 :] #)
  add1_256_df: octets_of(32) =
    (# length := 32, seq := [: 0x76, 0xa9, 0x4f, 0x22, 0x41, 0x78, 0xfe, 0x4c,
      0xbf, 0x9e, 0x2b, 0x8a, 0xcc, 0x53, 0xc9, 0xdc,
