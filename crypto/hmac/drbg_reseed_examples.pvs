% NIST DRBGVS (CAVP) SHA-256, COUNT = 0, 256-bit entropy,
% 128-bit nonce, 256-bit personalization and additional input, 1024-bit output.
% https://csrc.nist.gov/projects/cryptographic-algorithm-validation-program/random-number-generators
drbg_reseed_examples: THEORY
BEGIN
  IMPORTING hmac_drbg

  % drbgvectors_pr_false.zip, HMAC_DRBG.rsp.
  rs_entropy: octets_of(32) =
    (# length := 32, seq := [: 0xcd, 0xb0, 0xd9, 0x11, 0x7c, 0xc6, 0xdb, 0xc9,
      0xef, 0x9d, 0xcb, 0x06, 0xa9, 0x75, 0x79, 0x84,
      0x1d, 0x72, 0xdc, 0x18, 0xb2, 0xd4, 0x6a, 0x1c,
      0xb6, 0x1e, 0x31, 0x40, 0x12, 0xbd, 0xf4, 0x16 :] #)
  rs_nonce: octets_of(16) =
    (# length := 16, seq := [: 0xd0, 0xc0, 0xd0, 0x1d, 0x15, 0x60, 0x16, 0xd0,
      0xeb, 0x6b, 0x7e, 0x9c, 0x7c, 0x3c, 0x8d, 0xa8 :] #)
  rs_ps: octets_of(32) =
    (# length := 32, seq := [: 0x6f, 0x0f, 0xb9, 0xea, 0xb3, 0xf9, 0xea, 0x7a,
      0xb0, 0xa7, 0x19, 0xbf, 0xa8, 0x79, 0xbf, 0x0a,
      0xae, 0xd6, 0x83, 0x30, 0x7f, 0xda, 0x0c, 0x6d,
      0x73, 0xce, 0x01, 0x8b, 0x6e, 0x34, 0xfa, 0xaa :] #)
  rs_additional1: octets_of(32) =
    (# length := 32, seq := [: 0x16, 0xe2, 0xd0, 0x72, 0x1b, 0x58, 0xd8, 0x39,
      0xa1, 0x22, 0x85, 0x2a, 0xbd, 0x3b, 0xf2, 0xc9,
      0x42, 0xa3, 0x1c, 0x84, 0xd8, 0x2f, 0xca, 0x74,
      0x21, 0x18, 0x71, 0x88, 0x0d, 0x71, 0x62, 0xff :] #)
  rs_additional2: octets_of(32) =
    (# length := 32, seq := [: 0x53, 0x68, 0x6f, 0x04, 0x2a, 0x7b, 0x08, 0x7d,
      0x5d, 0x2e, 0xca, 0x0d, 0x2a, 0x96, 0xde, 0x13,
      0x1f, 0x27, 0x5e, 0xd7, 0x15, 0x11, 0x89, 0xf7,
      0xca, 0x52, 0xde, 0xaa, 0x78, 0xb7, 0x9f, 0xb2 :] #)
  rs_new_seed: octets_of(32) =
    (# length := 32, seq := [: 0x8e, 0xc6, 0xf7, 0xd5, 0xa8, 0xe2, 0xe8, 0x8f,
      0x43, 0x98, 0x6f, 0x70, 0xb8, 0x6e, 0x05, 0x0d,
      0x07, 0xc8, 0x4b, 0x93, 0x1b, 0xcf, 0x18, 0xe6,
      0x01, 0xc5, 0xa3, 0xee, 0xe3, 0x06, 0x4c, 0x82 :] #)
  rs_reseed_data: octets_of(32) =
    (# length := 32, seq := [: 0x1a, 0xb4, 0xca, 0x90, 0x14, 0xfa, 0x98, 0xa5,
      0x59, 0x38, 0x31, 0x6d, 0xe8, 0xba, 0x5a, 0x68,
      0xc6, 0x29, 0xb0, 0x74, 0x1b, 0xdd, 0x05, 0x8c,
      0x4d, 0x70, 0xc9, 0x1c, 0xda, 0x50, 0x99, 0xb3 :] #)
  rs_expected_lo: octets_of(64) =
    (# length := 64, seq := [: 0xdd, 0xa0, 0x4a, 0x2c, 0xa7, 0xb8, 0x14, 0x7a,
      0xf1, 0x54, 0x8f, 0x5d, 0x08, 0x65, 0x91, 0xca,
      0x4f, 0xd9, 0x51, 0xa3, 0x45, 0xce, 0x52, 0xb3,
      0xcd, 0x49, 0xd4, 0x7e, 0x84, 0xaa, 0x31, 0xa1,
      0x83, 0xe3, 0x1f, 0xbc, 0x42, 0xa1, 0xff, 0x1d,
      0x95, 0xaf, 0xec, 0x71, 0x43, 0xc8, 0x00, 0x8c,
      0x97, 0xbc, 0x2a, 0x9c, 0x09, 0x1d, 0xf0, 0xa7,
      0x63, 0x84, 0x83, 0x91, 0xf6, 0x8c, 0xb4, 0xa3 :] #)
  rs_expected_hi: octets_of(64) =
    (# length := 64, seq := [: 0x66, 0xad, 0x89, 0x85, 0x7a, 0xc7, 0x25, 0xa5,
      0x3b, 0x30, 0x3d, 0xde, 0xa7, 0x67, 0xbe, 0x8d,
      0xc5, 0xf6, 0x05, 0xb1, 0xb9, 0x5f, 0x6d, 0x24,
      0xc9, 0xf0, 0x6b, 0xe6, 0x5a, 0x97, 0x3a, 0x08,
      0x93, 0x20, 0xb3, 0xcc, 0x42, 0x56, 0x9d, 0xcf,
      0xd4, 0xb9, 0x2b, 0x62, 0xa9, 0x93, 0x78, 0x5b,
      0x03, 0x01, 0xb3, 0xfc, 0x45, 0x24, 0x45, 0x65,
      0x6f, 0xce, 0x22, 0x66, 0x48, 0x27, 0xb8, 0x8f :] #)
  rs_expected: octets_of(128) = join_octets(rs_expected_lo, rs_expected_hi)
  rs_initial: state = instantiate(h_sha256, rs_entropy, rs_nonce, rs_ps)
  rs_step1: result = generate(reseed(rs_initial, rs_new_seed, rs_reseed_data), 1024, rs_additional1)
  rs_step2: result = generate(rs_step1`current, 1024, rs_additional2)
  reseed_vector: _TEST_ rs_step1`success AND rs_step2`success AND rs_step2`data = rs_expected
  % drbgvectors_pr_true.zip, HMAC_DRBG.rsp.
  pr_entropy: octets_of(32) =
    (# length := 32, seq := [: 0x42, 0x94, 0x67, 0x1d, 0x49, 0x3d, 0xc0, 0x85,
      0xb5, 0x18, 0x46, 0x07, 0xd7, 0xde, 0x2f, 0xf2,
      0xb6, 0xac, 0xeb, 0x73, 0x4a, 0x1b, 0x02, 0x6f,
      0x6c, 0xfe, 0xe7, 0xc5, 0xa9, 0x0f, 0x03, 0xda :] #)
  pr_nonce: octets_of(16) =
    (# length := 16, seq := [: 0xd0, 0x71, 0x54, 0x4e, 0x59, 0x92, 0x35, 0xd5,
      0xeb, 0x38, 0xb6, 0x4b, 0x55, 0x1d, 0x2a, 0x6e :] #)
  pr_ps: octets_of(32) =
    (# length := 32, seq := [: 0x63, 0xbc, 0x76, 0x9a, 0xe1, 0xd9, 0x5a, 0x98,
      0xbd, 0xe8, 0x70, 0xe4, 0xdb, 0x77, 0x76, 0x29,
      0x70, 0x41, 0xd3, 0x7c, 0x8a, 0x5c, 0x68, 0x8d,
      0x4e, 0x02, 0x4b, 0x78, 0xd8, 0x3f, 0x4d, 0x78 :] #)
  pr_additional1: octets_of(32) =
    (# length := 32, seq := [: 0x28, 0x84, 0x8b, 0xec, 0xd3, 0xf4, 0x76, 0x96,
      0xf1, 0x24, 0xf4, 0xb1, 0x48, 0x53, 0xa4, 0x56,
      0x15, 0x6f, 0x69, 0xbe, 0x58, 0x3a, 0x7d, 0x46,
      0x82, 0xcf, 0xf8, 0xd4, 0x4b, 0x39, 0xe1, 0xd3 :] #)
  pr_additional2: octets_of(32) =
    (# length := 32, seq := [: 0x8b, 0xfc, 0xe0, 0xb7, 0x13, 0x26, 0x61, 0xc3,
      0xcd, 0x78, 0x17, 0x5d, 0x83, 0x92, 0x6f, 0x64,
      0x3e, 0x36, 0xf7, 0x60, 0x8e, 0xec, 0x2c, 0x5d,
      0xac, 0x3d, 0xdc, 0xba, 0xcc, 0x8c, 0x21, 0x82 :] #)
  pr_fresh1: octets_of(32) =
    (# length := 32, seq := [: 0xdb, 0x9b, 0x47, 0x90, 0xb6, 0x23, 0x36, 0xfb,
      0xb9, 0xa6, 0x84, 0xb8, 0x29, 0x47, 0x06, 0x53,
      0x93, 0xee, 0xef, 0x8f, 0x57, 0xbd, 0x24, 0x77,
      0x14, 0x1a, 0xd1, 0x7e, 0x77, 0x6d, 0xac, 0x34 :] #)
  pr_fresh2: octets_of(32) =
    (# length := 32, seq := [: 0x4a, 0x9a, 0xbe, 0x80, 0xf6, 0xf5, 0x22, 0xf2,
      0x98, 0x78, 0xbe, 0xdf, 0x82, 0x45, 0xb2, 0x79,
      0x40, 0xa7, 0x64, 0x71, 0x00, 0x6f, 0xb4, 0xa4,
      0x11, 0x0b, 0xeb, 0x4d, 0xec, 0xb6, 0xc3, 0x41 :] #)
  pr_expected_lo: octets_of(64) =
    (# length := 64, seq := [: 0xe5, 0x80, 0xdc, 0x96, 0x91, 0x94, 0xb2, 0xb1,
      0x8a, 0x97, 0x47, 0x8a, 0xef, 0x9d, 0x1a, 0x72,
      0x39, 0x0a, 0xff, 0x14, 0x56, 0x27, 0x47, 0xbf,
      0x08, 0x0d, 0x74, 0x15, 0x27, 0xa6, 0x65, 0x5c,
      0xe7, 0xfc, 0x13, 0x53, 0x25, 0xb4, 0x57, 0x48,
      0x3a, 0x9f, 0x9c, 0x70, 0xf9, 0x11, 0x65, 0xa8,
      0x11, 0xcf, 0x45, 0x24, 0xb5, 0x0d, 0x51, 0x19,
      0x9a, 0x0d, 0xf3, 0xbd, 0x60, 0xd1, 0x2a, 0xba :] #)
  pr_expected_hi: octets_of(64) =
    (# length := 64, seq := [: 0xc2, 0x7d, 0x0b, 0xf6, 0x61, 0x8e, 0x6b, 0x11,
      0x4e, 0x05, 0x42, 0x03, 0x52, 0xe2, 0x3f, 0x36,
      0x03, 0xdf, 0xe8, 0xa2, 0x25, 0xdc, 0x19, 0xb3,
      0xd1, 0xff, 0xf1, 0xdc, 0x24, 0x5d, 0xc6, 0xb1,
      0xdf, 0x24, 0xc7, 0x41, 0x74, 0x4b, 0xec, 0x3f,
      0x94, 0x37, 0xdb, 0xbf, 0x22, 0x2d, 0xf8, 0x48,
      0x81, 0xa4, 0x57, 0xa5, 0x89, 0xe7, 0x81, 0x5e,
      0xf1, 0x32, 0xf6, 0x86, 0xb7, 0x60, 0xf0, 0x12 :] #)
  pr_expected: octets_of(128) = join_octets(pr_expected_lo, pr_expected_hi)
  pr_initial: state = instantiate(h_sha256, pr_entropy, pr_nonce, pr_ps)
  pr_step1: result = reseed_and_generate(pr_initial, pr_fresh1, pr_additional1, 1024)
  pr_step2: result = reseed_and_generate(pr_step1`current, pr_fresh2, pr_additional2, 1024)
  prediction_resistance_vector: _TEST_ pr_step1`success AND pr_step2`success AND pr_step2`data = pr_expected
END drbg_reseed_examples
