                 0x33c9fc07,0x3fd4e6ae,0xdbe9c48b,0xaadd9db8 :] #)
    ELSE (# len:=8,word:=[: 0x00000000,0x00000000,0x00000000,0x00000000,
                 0x00000000,0x00000000,0x00000000,0x00000000 :] #)
    ENDIF
