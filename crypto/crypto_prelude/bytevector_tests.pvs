% Regression examples for big-endian octets and partial-word loads.
bytevector_tests: THEORY
BEGIN
  IMPORTING bytevectors, hex

  input: bytestring = hex2bytestring("123456789ABCDEF0")
  word_value: _TEST_ bytes2uint64(input, 0) = 0x123456789ABCDEF0
  short_word: _TEST_ bytes2uint64(input, 3) = 0x789ABCDEF0
  last_byte: _TEST_ bytes2uint64(input, 7) = 0xF0
  unequal_prefix: _TEST_ NOT equalUpto(input, hex2bytestring("123556"), 2)
  equal_prefix: _TEST_ equalUpto(input, hex2bytestring("123556"), 1)
  right_by_byte: _TEST_ byvrshft[8](input`seq, 1)(0) = 0 AND
                          byvrshft[8](input`seq, 1)(7) = 0xDE
  left_bit_rotation: _TEST_ byvleftrotate[8](input`seq, 1)(0) = 0x24 AND
                            byvleftrotate[8](input`seq, 1)(7) = 0xE0
  right_bit_rotation: _TEST_ byvrightrotate[8](input`seq, 1)(0) = 0x09 AND
                             byvrightrotate[8](input`seq, 1)(1) = 0x1A
  word_rotation: _TEST_ byvrightrotate[8](input`seq, 8)(0) = 0xF0 AND
                        byvleftrotate[8](input`seq, 8)(0) = 0x34
END bytevector_tests
