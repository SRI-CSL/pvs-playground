% FIPS 205, SHAKE and SHA2 instantiations of Algorithms 9, 10, 12, 14–16 and 18–19.
slh_sign: THEORY
BEGIN
  IMPORTING slh_verify
  origin: posn = (# use_sha2:=FALSE, layer:=0, tree:=0, leaf:=0 #)
  % Algorithm 15. At height zero PRF and F use different address types.
  fors_node(n: node_size,sk,seed: octets_of(n),pos: posn,idx: uint32,h: upto(14)):
      RECURSIVE octets_of(n) =
    IF h=0 THEN
      LET secret=thash(n,seed,addr(pos,6,0,idx),sk) IN thash(n,seed,addr(pos,3,0,idx),secret)
    ELSE LET left=u32lshift(idx,1),right=u32plus(left,1) IN
      hash_pair(n,seed,addr(pos,3,h,idx),fors_node(n,sk,seed,pos,left,h-1),
                                         fors_node(n,sk,seed,pos,right,h-1))
    ENDIF MEASURE h
  % Algorithm 9. WOTS+ retains the key-pair address. TREE clears it.
  xmss_node(n: node_size,sk,seed: octets_of(n),pos: posn,idx: uint32,h: upto(9)):
      RECURSIVE octets_of(n) =
    IF h=0 THEN wots_pk(n,sk,seed,pos WITH [leaf:=idx]) ELSE
      LET left=u32lshift(idx,1),right=u32plus(left,1) IN
        hash_pair(n,seed,addr(pos WITH [leaf:=0],2,h,idx),xmss_node(n,sk,seed,pos,left,h-1),
                                                            xmss_node(n,sk,seed,pos,right,h-1))
    ENDIF MEASURE h
  % Only the call sites with proven wire sizes use this writer. A caller may
  % also use it with a short output buffer to inspect a prefix of a signature.
  put(out: bytestring,base: uint32,data: bytestring): octets_of(out`length) =
    IF base>=out`length THEN out ELSE copy_octets(out,base,data,0) ENDIF
  fors_path(n: node_size,sk,seed: octets_of(n),pos: posn,idx,base: uint32,
            out: bytestring,h: upto(14),j: upto(h)): RECURSIVE octets_of(out`length) =
    IF j=h THEN out ELSE
      LET sib=u32xor(u32rshift(idx,j),1), x=fors_node(n,sk,seed,pos,sib,j) IN
        fors_path(n,sk,seed,pos,idx,u32plus(base,n),put(out,base,x),h,j+1)
    ENDIF MEASURE h-j
  fors_sign(p: profile,sk,seed: octets_of(node_bytes(p)),pos: posn,md: bytestring,
            base: uint32,out: bytestring,i: upto(forest_size(p))): RECURSIVE octets_of(out`length) =
    IF i=forest_size(p) THEN out ELSE
      LET a=fors_height(p), n=node_bytes(p), dig=bits_from(md,u32times(i,a),a,0),
          idx=u32plus(u32lshift(i,a),dig), x=thash(n,seed,addr(pos,6,0,idx),sk),
          sig=fors_path(n,sk,seed,pos,idx,u32plus(base,n),put(out,base,x),a,0),
          step=u32times(u8plus(a,1),n) IN
        fors_sign(p,sk,seed,pos,md,u32plus(base,step),sig,i+1)
    ENDIF MEASURE forest_size(p)-i
  xmss_path(n: node_size,sk,seed: octets_of(n),pos: posn,base: uint32,
            out: bytestring,h: upto(9),j: upto(h)): RECURSIVE octets_of(out`length) =
    IF j=h THEN out ELSE
      LET sib=u32xor(u32rshift(pos`leaf,j),1), x=xmss_node(n,sk,seed,pos,sib,j) IN
        xmss_path(n,sk,seed,pos,u32plus(base,n),put(out,base,x),h,j+1)
    ENDIF MEASURE h-j
  ht_sign(p: profile,sk,seed,m: octets_of(node_bytes(p)),pos: posn,out: bytestring,base: uint32,
          remaining: uint8): RECURSIVE octets_of(out`length) =
    IF remaining=0 THEN out ELSE
      LET n=node_bytes(p), h=xmss_height(p), ws=wots_sign(n,sk,seed,m,pos),
          authbase=u32plus(base,ws`length),
          sig=xmss_path(n,sk,seed,pos,authbase,put(out,base,ws),h,0) IN
        IF remaining=1 THEN sig ELSE
          LET leaf=wots_recover(n,seed,m,pos,ws),
              root=auth_path(n,seed,pos WITH [leaf:=0],2,sig,authbase,pos`leaf,leaf,0,h) IN
            ht_sign(p,sk,seed,root,next_pos(p,pos),sig,u32plus(authbase,u32times(h,n)),remaining-1)
        ENDIF
    ENDIF MEASURE remaining
  keys: TYPE = [# pk,sk: bytestring #]
  keygen_internal(p: profile,sk,prf,seed: octets_of(node_bytes(p))): keys =
    LET n=node_bytes(p), top=origin WITH [use_sha2:=p>=6, layer:=u32minus(layers(p),1)],
        root=xmss_node(n,sk,seed,top,0,xmss_height(p)),
        pk=join_octets(seed,root) IN
      (# pk:=pk, sk:=join_octets(join_octets(sk,prf),pk) #)
  private_key(p: profile): TYPE = octets_of(4*node_bytes(p))
  % Section 11.2: PRF_msg uses HMAC-SHA-256 at n=16 and HMAC-SHA-512 otherwise.
  % SK.prf is always shorter than a compression block.
  hmac_pad(wide: bool,k: bytestring,pad: uint8): octets_of(block_width(wide)) =
    (# length:=block_width(wide),seq:=LAMBDA(j: below(block_width(wide))):
      IF j<k`length THEN u8xor(k`seq(j),pad) ELSE pad ENDIF #)
  message_prf(p: profile,k,opt: octets_of(node_bytes(p)),ctx: context_t,m: bytestring,
              external: bool): octets_of(node_bytes(p)) =
    LET n=node_bytes(p) IN
    IF p<6 THEN output(finish_shake(frame(absorb(absorb(start(136),k),opt),ctx,m,external)),n)
    ELSE
      LET wide=n>16, h=stream_start(wide), first=stream_add(stream_add(h,hmac_pad(wide,k,0x36)),opt),
          inner=full_digest(sha_frame(first,ctx,m,external)),
          outer=stream_add(stream_add(h,hmac_pad(wide,k,0x5c)),inner) IN
        stream_digest(outer,n)
    ENDIF
  % Algorithms 19 and 22. Use the public seed as opt_rand for deterministic signing.
  sign_message(p: profile,key: private_key(p),opt_rand: octets_of(node_bytes(p)),
               ctx: context_t,m: bytestring,external: bool): octets_of(wire_size(p)) =
    LET n=node_bytes(p), sk=part(key,0,n), prf=part(key,n,n), seed=part(key,u32times(2,n),n),
        root=part(key,u32times(3,n),n), r=message_prf(p,prf,opt_rand,ctx,m,external),
        digest=message_digest(p,r,seed,root,ctx,m,external), pos=digest_pos(p,digest),
        initial=put(fill_octets(wire_size(p),0),0,r), sig=fors_sign(p,sk,seed,pos,digest,n,initial,0),
        f=fors_nodes(p,seed,pos,digest,sig,domain(n,seed,addr(pos,4,0,0)),n,0),
        base=u32times(u32plus(1,u32times(forest_size(p),u8plus(fors_height(p),1))),n) IN
      ht_sign(p,sk,seed,f,pos,sig,base,layers(p))
END slh_sign
