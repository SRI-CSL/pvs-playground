% FIPS 180-4 §§5–6. One-shot and incremental digest interfaces.
secure_hash_claims: THEORY
BEGIN
  IMPORTING sha2_stream
  sha256_stream_equivalence: THEOREM FORALL(m:bytestring):
    stream_digest(stream_add(stream_start(FALSE),m),32)=sha256(m)
  sha512_stream_equivalence: THEOREM FORALL(m:bytestring):
    stream_digest(stream_add(stream_start(TRUE),m),64)=sha512(m)
  chunk_independence: THEOREM FORALL(s:stream,a:bytestring,b:{x:bytestring | a`length+x`length<maxsize}):
    stream_add(stream_add(s,a),b)=stream_add(s,join_octets(a,b))
END secure_hash_claims
