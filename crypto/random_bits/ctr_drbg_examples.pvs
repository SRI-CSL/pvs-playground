  rsi_128_direct: octets_of(32) =
    (# length := 32, seq := [: 0xf7, 0xa0, 0x37, 0x83, 0x28, 0xd9, 0x39, 0xf0,
      0xf8, 0x52, 0x1e, 0x39, 0x40, 0x9d, 0x71, 0x75,
