% FIPS 198-1, section 4, Table 1. https://doi.org/10.6028/NIST.FIPS.198-1
keyed_hash: THEORY
BEGIN
  sha2: LIBRARY = "../sha2"
  sha3: LIBRARY = "../sha3"
  crypto_prelude: LIBRARY = "../crypto_prelude"
  IMPORTING sha2@secure_hash, sha3@keccak, crypto_prelude@crypto_buffers

  hash_id: TYPE = below(11)
  h_sha1: hash_id = 0
  h_sha224: hash_id = 1
  h_sha256: hash_id = 2
  h_sha384: hash_id = 3
  h_sha512: hash_id = 4
  h_sha512_224: hash_id = 5
  h_sha512_256: hash_id = 6
  h_sha3_224: hash_id = 7
  h_sha3_256: hash_id = 8
  h_sha3_384: hash_id = 9
  h_sha3_512: hash_id = 10

  % FIPS 180-4 section 1 and FIPS 202 Appendix A.1.
  hash_bytes(h: hash_id): subrange(20, 64) =
    COND
      h = h_sha1 -> 20,
      h = h_sha224 -> 28,
      h = h_sha256 -> 32,
      h = h_sha384 -> 48,
      h = h_sha512 -> 64,
      h = h_sha512_224 -> 28,
      h = h_sha512_256 -> 32,
      h = h_sha3_224 -> 28,
      h = h_sha3_256 -> 32,
      h = h_sha3_384 -> 48,
      ELSE -> 64
    ENDCOND

  block_bytes(h: hash_id): subrange(64, 144) =
    COND
      h = h_sha1 -> 64,
      h = h_sha224 -> 64,
      h = h_sha256 -> 64,
      h = h_sha384 -> 128,
      h = h_sha512 -> 128,
      h = h_sha512_224 -> 128,
      h = h_sha512_256 -> 128,
      h = h_sha3_224 -> 144,
      h = h_sha3_256 -> 136,
      h = h_sha3_384 -> 104,
      ELSE -> 72
    ENDCOND

  hash_message(h: hash_id, m: bytestring): octets_of(hash_bytes(h)) =
    COND
      h = h_sha1 -> sha1(m),
      h = h_sha224 -> sha224(m),
      h = h_sha256 -> sha256(m),
      h = h_sha384 -> sha384(m),
      h = h_sha512 -> sha512(m),
      h = h_sha512_224 -> sha512_224(m),
      h = h_sha512_256 -> sha512_256(m),
      h = h_sha3_224 -> sha3_224(m),
      h = h_sha3_256 -> sha3_256(m),
      h = h_sha3_384 -> sha3_384(m),
      ELSE -> sha3_512(m)
    ENDCOND

  % Table 1, steps 1--3. Long keys are hashed once, then right-zero-padded.
  key_block(h: hash_id, k: bytestring): octets_of(block_bytes(h)) =
    LET used = IF k`length > block_bytes(h) THEN hash_message(h, k) ELSE k ENDIF
    IN (# length := block_bytes(h), seq := LAMBDA (i: below(block_bytes(h))):
          IF i < used`length THEN used`seq(i) ELSE 0 ENDIF #)

  pad_key(k: bytestring, pad: uint8): octets_of(k`length) =
    (# length := k`length, seq := LAMBDA (i: below(k`length)): u8xor(k`seq(i), pad) #)

  % Steps 4--9. Input bound accounts for the prefixed block in a Prelude array.
  hmac_input(h: hash_id): TYPE =
    {s: bytestring | block_bytes(h) + s`length < maxsize}
  hmac(h: hash_id, k: bytestring, m: hmac_input(h)): octets_of(hash_bytes(h)) =
    LET block = key_block(h, k),
        inner = hash_message(h, join_octets(pad_key(block, 0x36), m))
    IN hash_message(h, join_octets(pad_key(block, 0x5c), inner))

  % Section 5. Return the requested leftmost full bytes.
  hmac_truncated(h: hash_id, k: bytestring, m: hmac_input(h), n: upto(hash_bytes(h))):
    octets_of(n) = first_octets(hmac(h, k, m), n)

  short_key_padding: LEMMA FORALL (h: hash_id, k: bytestring, i: below(block_bytes(h))):
    k`length <= block_bytes(h) IMPLIES
      key_block(h, k)`seq(i) = IF i < k`length THEN k`seq(i) ELSE 0 ENDIF
END keyed_hash
